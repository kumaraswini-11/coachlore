{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL",
        "VERCEL_URL",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ],
      "passThroughEnv": ["CI", "NEXT_RUNTIME"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["PLAYWRIGHT_*", "CI"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint:logical-css": {
      "inputs": [
        "scripts/check-logical-css.ts",
        "apps/web/**/*.{ts,tsx,css}",
        "packages/ui/src/**/*.{ts,tsx,css}",
        "!**/node_modules/**",
        "!apps/web/.next/**"
      ]
    }
  }
}
