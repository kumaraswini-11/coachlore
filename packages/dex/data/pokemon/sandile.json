{
  "category": "Desert Croc Pokémon",
  "entries": [
    {
      "text": "They live buried in the sands of the desert. The sun-warmed sands prevent their body temperature from dropping.",
      "version": "black"
    },
    {
      "text": "It moves along below the sand’s surface, except for its nose and eyes. A dark membrane shields its eyes from the sun.",
      "version": "white"
    },
    {
      "text": "They live hidden under hot desert sands in order to keep their body temperature from dropping.",
      "version": "black-2"
    },
    {
      "text": "They live hidden under hot desert sands in order to keep their body temperature from dropping.",
      "version": "white-2"
    },
    {
      "text": "It moves along below the sand’s surface, except for its nose and eyes. A dark membrane shields its eyes from the sun.",
      "version": "x"
    },
    {
      "text": "They live buried in the sands of the desert. The sun-warmed sands prevent their body temperature from dropping.",
      "version": "y"
    },
    {
      "text": "It moves along below the sand’s surface, except for its nose and eyes. A dark membrane shields its eyes from the sun.",
      "version": "omega-ruby"
    },
    {
      "text": "They live buried in the sands of the desert. The sun-warmed sands prevent their body temperature from dropping.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It submerges itself in sand and moves as if swimming. This wise behavior keeps its enemies from finding it and maintains its temperature.",
      "version": "sun"
    },
    {
      "text": "It conceals itself in the sand and chomps down on the legs of any prey that unwarily walk over it. Its favorite food is Trapinch.",
      "version": "moon"
    },
    {
      "text": "Alola, where it’s warm all year round, is a comfortable environment for this Pokémon. Sometimes you’ll even see it outside of deserts.",
      "version": "ultra-sun"
    },
    {
      "text": "Sandile’s still not good at hunting, so it mostly eats things that have collapsed in the desert. It’s called “the cleaner of the desert.”",
      "version": "ultra-moon"
    },
    {
      "text": "The desert gets cold at night, so when the sun sets, this Pokémon burrows deep into the sand and sleeps until sunrise.",
      "version": "sword"
    },
    {
      "text": "Sandile is small, but its legs and lower body are powerful. Pushing sand aside as it goes, Sandile moves through the desert as if it’s swimming.",
      "version": "shield"
    }
  ],
