{
  "category": "Gnash Teeth Pokémon",
  "entries": [
    {
      "text": "When it unleashes its psychic power from the protuberance on its head, the grating sound of grinding teeth echoes through the area.",
      "version": "sun"
    },
    {
      "text": "It stuns its prey with psychokinesis and then grinds them to mush with its strong teeth. Even Shellder’s shell is no match for it.",
      "version": "moon"
    },
    {
      "text": "It burrows beneath the sand, radiating psychic power from the protuberance on its head. It waits for prey as it surveys the area.",
      "version": "ultra-sun"
    },
    {
      "text": "Its skin is thick enough to fend off Mareanie’s spikes. With its robust teeth, Bruxish crunches up the spikes and eats them.",
      "version": "ultra-moon"
    }
  ],
