{
  "category": "Floating Pokémon",
  "entries": [
    {
      "text": "With its thin, veil-like arms wrapped around the body of its opponent, it sinks to the ocean floor.",
      "version": "black"
    },
    {
      "text": "They paralyze prey with poison, then drag them down to their lairs, five miles below the surface.",
      "version": "white"
    },
    {
      "text": "If its veil-like arms stun and wrap a foe, that foe will be dragged miles below the surface, never to return.",
      "version": "black-2"
    },
    {
      "text": "If its veil-like arms stun and wrap a foe, that foe will be dragged miles below the surface, never to return.",
      "version": "white-2"
    },
