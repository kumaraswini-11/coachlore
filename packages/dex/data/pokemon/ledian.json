{
  "category": "Five Star Pokémon",
  "entries": [
    {
      "text": "When the stars flicker in the night sky, it flutters about, scattering a glowing powder.",
      "version": "gold"
    },
    {
      "text": "The star patterns on its back grow larger or smaller depending on the number of stars in the night sky.",
      "version": "silver"
    },
    {
      "text": "In the daytime when it gets warm, it curls up inside a big leaf and drifts off into a deep slumber.",
      "version": "crystal"
    },
    {
      "text": "It is said that in lands with clean air, where the stars fill the sky, there live LEDIAN in countless numbers. There is a good reason for this - the POKéMON uses the light of the stars as its energy.",
      "version": "ruby"
    },
    {
      "text": "It is said that in lands with clean air, where the stars fill the sky, there live LEDIAN in countless numbers. There is a good reason for this - the POKéMON uses the light of the stars as its energy.",
      "version": "sapphire"
    },
    {
      "text": "It is said that in lands with clean air, where the stars fill the sky, there live many LEDIAN. For good reason, they use the light of the stars as energy.",
      "version": "emerald"
    },
    {
      "text": "The star patterns on its back grow larger or smaller depending on the number of stars in the night sky.",
      "version": "firered"
