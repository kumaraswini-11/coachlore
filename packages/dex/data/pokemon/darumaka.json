{
  "category": "Zen Charm Pokémon",
  "entries": [
    {
      "text": "When its internal fire is burning, it cannot calm down and it runs around. When the fire diminishes, it falls asleep.",
      "version": "black"
    },
    {
      "text": "Darumaka’s droppings are hot, so people used to put them in their clothes to keep themselves warm.",
      "version": "white"
    },
    {
      "text": "When it sleeps, it pulls its limbs into its body and its internal fire goes down to 1,100° F.",
      "version": "black-2"
    },
    {
      "text": "When it sleeps, it pulls its limbs into its body and its internal fire goes down to 1,100° F.",
      "version": "white-2"
    },
    {
      "text": "Darumaka’s droppings are hot, so people used to put them in their clothes to keep themselves warm.",
      "version": "x"
    },
    {
      "text": "When it sleeps, it pulls its limbs into its body and its internal fire goes down to 1,100 degrees Fahrenheit.",
      "version": "y"
    },
    {
      "text": "Darumaka’s droppings are hot, so people used to put them in their clothes to keep themselves warm.",
      "version": "omega-ruby"
    },
    {
      "text": "When it sleeps, it pulls its limbs into its body and its internal fire goes down to 1,100 degrees Fahrenheit.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It derives its power from fire burning inside its body. If the fire dwindles, this Pokémon will immediately fall asleep.",
      "version": "sword"
    },
    {
      "text": "This popular symbol of good fortune will never fall over in its sleep, no matter how it’s pushed or pulled.",
      "version": "shield"
    }
