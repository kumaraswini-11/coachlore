{
  "category": "Stakeout Pokémon",
  "entries": [
    {
      "text": "When it finds a trace of its prey, it patiently stakes out the location...but it’s always snoozing by nightfall.",
      "version": "sun"
    },
    {
      "text": "It adores having Rattata and Raticate for dinner, but as it’s diurnal, it never encounters them. This Pokémon boasts incredible patience.",
      "version": "moon"
    },
    {
      "text": "Although it wasn’t originally found in Alola, this Pokémon was brought over a long time ago when there was a huge Rattata outbreak.",
      "version": "ultra-sun"
    },
    {
      "text": "Patient by nature, this Pokémon loses control of itself and pounces when it spots its favorite meal—Rattata!",
      "version": "ultra-moon"
    }
  ],
