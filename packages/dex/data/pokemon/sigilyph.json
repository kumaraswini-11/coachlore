  "entries": [
    {
      "text": "They never vary the route they fly, because their memories of guarding an ancient city remain steadfast.",
      "version": "black"
    },
    {
      "text": "The guardians of an ancient city, they use their psychic power to attack enemies that invade their territory.",
      "version": "white"
    },
    {
      "text": "The guardians of an ancient city, they always fly the same route while keeping watch for invaders.",
