  "entries": [
    {
      "text": "Groups of them beat up anything that enters their territory. Each can spit acidic liquid from its mouth.",
      "version": "black"
    },
    {
      "text": "It can smash concrete blocks with its kicking attacks. The one with the biggest crest is the group leader.",
      "version": "white"
    },
    {
      "text": "It pulls up its shed skin to protect itself while it kicks. The bigger the crest, the more respected it is.",
