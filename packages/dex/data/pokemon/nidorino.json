  "entries": [
    {
      "text": "An aggressive POKéMON that is quick to attack. The horn on its head secretes a powerful venom.",
      "version": "red"
    },
    {
      "text": "An aggressive POKéMON that is quick to attack. The horn on its head secretes a powerful venom.",
      "version": "blue"
    },
    {
      "text": "Its horns contain venom. If they are stabbed into an enemy, the impact makes the poison leak out.",
      "version": "yellow"
    },
    {
      "text": "It raises its big ears to check its surroundings. If it senses anything, it attacks immediately.",
      "version": "gold"
    },
    {
      "text": "Quick to anger, it stabs enemies with its horn to inject a powerful poison when it becomes agitated.",
      "version": "silver"
    },
    {
      "text": "It is easily agitated and uses its horn for offense as soon as it notices an attacker.",
      "version": "crystal"
    },
    {
