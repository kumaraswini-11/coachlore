{
  "category": "Playhouse Pokémon",
  "entries": [
    {
      "text": "It loves round white things. It carries an egg-shaped rock in imitation of CHANSEY.",
      "version": "diamond"
    },
    {
      "text": "It carries a round, egg-shaped rock in its belly pouch and gives the rock to its friends.",
      "version": "pearl"
    },
    {
      "text": "It likes to carry around a small rock. It may wander around others’ feet and cause them to stumble.",
      "version": "platinum"
    },
    {
      "text": "It carefully carries a round, white rock that it thinks is an egg. It’s bothered by how curly its hair looks.",
      "version": "heartgold"
    },
    {
      "text": "It carefully carries a round, white rock that it thinks is an egg. It’s bothered by how curly its hair looks.",
      "version": "soulsilver"
    },
    {
      "text": "It likes to carry around a small rock. It may wander around others’ feet and cause them to stumble.",
      "version": "black"
    },
    {
      "text": "It likes to carry around a small rock. It may wander around others’ feet and cause them to stumble.",
      "version": "white"
    },
    {
      "text": "It likes to carry around a small rock. It may wander around others’ feet and cause them to stumble.",
      "version": "black-2"
    },
    {
      "text": "It likes to carry around a small rock. It may wander around others’ feet and cause them to stumble.",
      "version": "white-2"
    },
    {
      "text": "It carries a round, egg-shaped rock in its belly pouch and gives the rock to its friends.",
      "version": "x"
    },
    {
      "text": "It carefully carries a round, white rock that it thinks is an egg. It’s bothered by how curly its hair looks.",
      "version": "y"
    },
    {
      "text": "It carries a round, egg-shaped rock in its belly pouch and gives the rock to its friends.",
      "version": "omega-ruby"
    },
    {
      "text": "It carefully carries a round, white rock that it thinks is an egg. It’s bothered by how curly its hair looks.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It carries a round white rock in its belly pouch. If it gets along well with someone, it will sometimes give that person the rock.",
      "version": "sun"
    },
    {
      "text": "It’s too small to lay eggs yet. As a surrogate, it searches out round white stones.",
      "version": "moon"
    },
    {
      "text": "Usually it’s a well-behaved Pokémon, but if you take its round rock away, it will cry and fuss and throw a big old tantrum.",
      "version": "ultra-sun"
    },
    {
      "text": "When it sees something round and white, Happiny puts it into the pouch on its stomach. It sometimes becomes overloaded and can’t move.",
      "version": "ultra-moon"
    },
    {
      "text": "Mimicking Chansey, Happiny will place an egg- shaped stone in its belly pouch. Happiny will treasure this stone.",
      "version": "sword"
    },
    {
      "text": "Happiny’s willing to lend its precious round stone to those it’s friendly with, but if the stone isn’t returned, Happiny will cry and throw a tantrum.",
      "version": "shield"
    },
    {
      "text": "In imitation of Chansey, it keeps a round stone tucked into its belly pouch and cherishes it dearly. It gets along well with children and will sometimes play house with them for fun.",
      "version": "legends-arceus"
    }
  ],
