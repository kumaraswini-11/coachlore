    {
      "text": "Using the long fur on its arms like whips, it launches into combo attacks that, once started, no one can stop.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It overwhelms its opponents with continuous attacks and then slowly stores up power before delivering the finishing blow.",
      "version": "ultra-sun"
    },
    {
      "text": "When Mienshao lets out a bizarre wail, you’re in danger. A flurry of kicks and chops too fast to see is about to be unleashed!",
      "version": "ultra-moon"
    },
    {
      "text": "When Mienshao comes across a truly challenging opponent, it will lighten itself by biting off the fur on its arms.",
      "version": "sword"
    },
    {
      "text": "Delivered at blinding speeds, kicks from this Pokémon can shatter massive boulders into tiny pieces.",
      "version": "shield"
    }
