{
  "category": "Rock Inn Pokémon",
  "entries": [
    {
      "text": "This Pokémon can easily melt holes in hard rocks with a liquid secreted from its mouth.",
      "version": "black"
    },
    {
      "text": "It makes a hole in a suitable rock. If that rock breaks, the Pokémon remains agitated until it locates a replacement.",
      "version": "white"
    },
    {
      "text": "When it finds a stone of a suitable size, it secretes a liquid from its mouth to open up a hole to crawl into.",
      "version": "black-2"
    },
    {
      "text": "When it finds a stone of a suitable size, it secretes a liquid from its mouth to open up a hole to crawl into.",
      "version": "white-2"
    },
    {
      "text": "It makes a hole in a suitable rock. If that rock breaks, the Pokémon remains agitated until it locates a replacement.",
      "version": "x"
    },
    {
      "text": "When it finds a stone of a suitable size, it secretes a liquid from its mouth to open up a hole to crawl into.",
      "version": "y"
    },
    {
      "text": "It makes a hole in a suitable rock. If that rock breaks, the Pokémon remains agitated until it locates a replacement.",
      "version": "omega-ruby"
    },
    {
      "text": "When it finds a stone of a suitable size, it secretes a liquid from its mouth to open up a hole to crawl into.",
      "version": "alpha-sapphire"
    },
    {
      "text": "When it finds a stone appealing, it creates a hole inside it and uses it as its home. This Pokémon is the natural enemy of Roggenrola and Rolycoly.",
      "version": "sword"
    },
    {
      "text": "It first tries to find a rock to live in, but if there are no suitable rocks to be found, Dwebble may move in to the ports of a Hippowdon.",
      "version": "shield"
    }
  ],
