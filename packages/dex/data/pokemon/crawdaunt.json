{
  "category": "Rogue Pokémon",
  "entries": [
    {
      "text": "CRAWDAUNT has an extremely violent nature that compels it to challenge other living things to battle. Other life-forms refuse to live in ponds inhabited by this POKéMON, making them desolate places.",
      "version": "ruby"
    },
    {
      "text": "CRAWDAUNT molts (sheds) its shell regularly. Immediately after molting, its shell is soft and tender. Until the shell hardens, this POKéMON hides in its streambed burrow to avoid attack from its foes.",
      "version": "sapphire"
    },
    {
      "text": "A brutish POKéMON that loves to battle. A veteran CRAWDAUNT that has prevailed in hundreds of battles has giant pincers marked with countless scars.",
      "version": "emerald"
    },
    {
      "text": "A rough customer that wildly flails its giant claws. It is said to be extremely hard to raise.",
      "version": "firered"
    },
    {
      "text": "A rough customer that wildly flails its giant claws. It is said to be extremely hard to raise.",
      "version": "leafgreen"
    },
    {
      "text": "It is a ruffian that uses its pincers to pick up and toss out other Pokémon from its pond.",
      "version": "diamond"
    },
    {
      "text": "It is a ruffian that uses its pincers to pick up and toss out other Pokémon from its pond.",
      "version": "pearl"
    },
    {
      "text": "It is a ruffian that uses its pincers to pick up and toss out other Pokémon from its pond.",
      "version": "platinum"
    },
    {
      "text": "A brutish Pokémon that loves to battle. It will crash itself into any foe that approaches its nest.",
      "version": "heartgold"
    },
    {
      "text": "A brutish Pokémon that loves to battle. It will crash itself into any foe that approaches its nest.",
      "version": "soulsilver"
    },
    {
      "text": "It is a ruffian that uses its pincers to pick up and toss out other Pokémon from its pond.",
      "version": "black"
    },
    {
      "text": "It is a ruffian that uses its pincers to pick up and toss out other Pokémon from its pond.",
      "version": "white"
    },
    {
      "text": "Loving to battle, this Pokémon pinches all Pokémon that enter its territory with its pincers and throws them out.",
      "version": "black-2"
    },
    {
      "text": "Loving to battle, this Pokémon pinches all Pokémon that enter its territory with its pincers and throws them out.",
      "version": "white-2"
