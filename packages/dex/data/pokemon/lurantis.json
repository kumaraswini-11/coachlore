{
  "category": "Bloom Sickle Pokémon",
  "entries": [
    {
      "text": "It requires a lot of effort to maintain Lurantis’s vivid coloring, but some collectors enjoy this work and treat it as their hobby.",
      "version": "sun"
    },
    {
      "text": "It fires beams from its sickle-shaped petals. These beams are powerful enough to cleave through thick metal plates.",
      "version": "moon"
    },
    {
      "text": "For self-protection, it pretends to be a bug Pokémon. Both of its arms bear keen-edged petals.",
      "version": "ultra-sun"
    },
    {
      "text": "As it slashes into its enemies, it looks like it’s dancing. Its elegant appearance has led some to call it the most glamorous Grass Pokémon.",
      "version": "ultra-moon"
    },
    {
      "text": "This Pokémon resembles a beautiful flower. A properly raised Lurantis will have gorgeous, brilliant colors.",
      "version": "sword"
    },
    {
      "text": "The petals on this Pokémon’s arms are thin and super sharp, and they can fire laser beams if Lurantis gathers light first.",
      "version": "shield"
    }
  ],
