{
  "category": "Wing Fish Pokémon",
  "entries": [
    {
      "text": "After long exposure to sunlight, the patterns on its tail fins shine vividly when darkness arrives.",
      "version": "diamond"
    },
    {
      "text": "The way its two tail fins flutter while it swims has earned it the nickname “BEAUTIFLY of the Sea.”",
      "version": "pearl"
    },
    {
      "text": "The line running down its side can store sunlight. It shines vividly at night.",
      "version": "platinum"
    },
    {
      "text": "Swimming and fluttering its two tail fins, it looks like a BEAUTIFLY. At night, the patterns on its tail fins softly shine.",
      "version": "heartgold"
    },
    {
      "text": "Swimming and fluttering its two tail fins, it looks like a BEAUTIFLY. At night, the patterns on its tail fins softly shine.",
      "version": "soulsilver"
    },
    {
      "text": "The line running down its side can store sunlight. It shines vividly at night.",
      "version": "black"
    },
    {
      "text": "The line running down its side can store sunlight. It shines vividly at night.",
      "version": "white"
    },
    {
