{
  "category": "Worm Pokémon",
  "entries": [
    {
      "text": "Using the spikes on its rear end, WURMPLE peels the bark off trees and feeds on the sap that oozes out. This POKéMON’s feet are tipped with suction pads that allow it to cling to glass without slipping.",
      "version": "ruby"
    },
    {
      "text": "WURMPLE is targeted by SWELLOW as prey. This POKéMON will try to resist by pointing the spikes on its rear at the attacking predator. It will weaken the foe by leaking poison from the spikes.",
      "version": "sapphire"
    },
    {
      "text": "It sticks to tree branches and eats leaves. The thread it spits from its mouth, which becomes gooey when it touches air, slows the movement of its foes.",
      "version": "emerald"
    },
    {
      "text": "It lives amidst tall grass and in forests. When attacked, it resists by pointing its venomous spikes at the foe.",
      "version": "firered"
    },
    {
      "text": "It lives amidst tall grass and in forests. When attacked, it resists by pointing its venomous spikes at the foe.",
      "version": "leafgreen"
    },
    {
      "text": "It loves to eat leaves. If it is attacked by a STARLY, it will defend itself with its spiked rear.",
      "version": "diamond"
    },
    {
      "text": "It spits a white silk that turns sticky when it contacts air. It is used to immobilize foes.",
      "version": "pearl"
    },
    {
      "text": "Often targeted by bird Pokémon, it desperately resists by releasing poison from its tail spikes.",
      "version": "platinum"
    },
    {
      "text": "It lives among the tall grass and in forests. It repels attacks by raising up the spikes on its rear.",
      "version": "heartgold"
    },
    {
      "text": "It lives among the tall grass and in forests. It repels attacks by raising up the spikes on its rear.",
      "version": "soulsilver"
    },
    {
      "text": "Often targeted by bird Pokémon, it desperately resists by releasing poison from its tail spikes.",
      "version": "black"
    },
    {
      "text": "Often targeted by bird Pokémon, it desperately resists by releasing poison from its tail spikes.",
      "version": "white"
    },
    {
      "text": "Often targeted by bird Pokémon, it desperately resists by releasing poison from its tail spikes.",
      "version": "black-2"
    },
    {
      "text": "Often targeted by bird Pokémon, it desperately resists by releasing poison from its tail spikes.",
      "version": "white-2"
    },
    {
      "text": "It loves to eat leaves. If it is attacked by a Starly, it will defend itself with its spiked rear.",
      "version": "x"
    },
    {
      "text": "It lives among the tall grass and in forests. It repels attacks by raising up the spikes on its rear.",
      "version": "y"
    },
    {
      "text": "Using the spikes on its rear end, Wurmple peels the bark off trees and feeds on the sap that oozes out. This Pokémon’s feet are tipped with suction pads that allow it to cling to glass without slipping.",
      "version": "omega-ruby"
    },
    {
      "text": "Wurmple is targeted by Swellow as prey. This Pokémon will try to resist by pointing the spikes on its rear at the attacking predator. It will weaken the foe by leaking poison from the spikes.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Likes sap and is abundant in the wild. Why it evolves into various different forms is unknown. One cannot tell from a Wurmple's appearance which form it will take when it evolves.",
      "version": "legends-arceus"
    }
  ],
