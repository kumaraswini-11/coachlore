{
  "category": "Frog Pokémon",
  "entries": [
    {
      "text": "If POLIWAG and POLIWHIRL hear its echoing cry, they respond by gathering from far and wide.",
      "version": "gold"
    },
    {
      "text": "Whenever three or more of these get together, they sing in a loud voice that sounds like bellowing.",
      "version": "silver"
    },
    {
      "text": "When it expands its throat to croak out a tune, nearby POLIWAG and POLIWHIRL gather immediately.",
      "version": "crystal"
    },
    {
      "text": "The curled hair on POLITOED’s head is proof of its status as a king. It is said that the longer and more curled the hair, the more respect this POKéMON earns from its peers.",
      "version": "ruby"
    },
    {
      "text": "The curled hair on POLITOED’s head is proof of its status as a king. It is said that the longer and more curled the hair, the more respect this POKéMON earns from its peers.",
      "version": "sapphire"
    },
    {
      "text": "The curled hair on its head proves its status as a king. It is said that the longer and curlier the hair, the more respect it earns from its peers.",
      "version": "emerald"
    },
    {
      "text": "Whenever three or more of these get together, they sing in a loud voice that sounds like bellowing.",
      "version": "firered"
    },
    {
      "text": "If POLIWAG and POLIWHIRL hear its echoing cry, they respond by gathering from far and wide.",
      "version": "leafgreen"
    },
    {
      "text": "It gathers groups of others as their leader. Its cries make POLIWAG obey.",
      "version": "diamond"
    },
