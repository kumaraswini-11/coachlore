{
  "category": "Butterfly Pokémon",
  "entries": [
    {
      "text": "In battle, it flaps its wings at high speed to release highly toxic dust into the air.",
      "version": "red"
    },
    {
      "text": "In battle, it flaps its wings at high speed to release highly toxic dust into the air.",
      "version": "blue"
    },
    {
      "text": "Its wings, covered with poisonous powders, repel water. This allows it to fly in the rain.",
      "version": "yellow"
    },
    {
      "text": "It collects honey every day. It rubs honey onto the hairs on its legs to carry it back to its nest.",
      "version": "gold"
    },
    {
      "text": "Water-repellent powder on its wings enables it to collect honey, even in the heaviest of rains.",
      "version": "silver"
    },
    {
      "text": "It flits from flower to flower, collecting honey. It can even identify distant flowers in bloom.",
      "version": "crystal"
    },
    {
      "text": "BUTTERFREE has a superior ability to search for delicious honey from flowers. It can even search out, extract, and carry honey from flowers that are blooming over six miles from its nest.",
      "version": "ruby"
    },
    {
      "text": "BUTTERFREE has a superior ability to search for delicious honey from flowers. It can even search out, extract, and carry honey from flowers that are blooming over six miles from its nest.",
      "version": "sapphire"
    },
    {
      "text": "It has a superior ability to search for delicious honey from flowers. It can seek, extract, and carry honey from flowers blooming over six miles away.",
      "version": "emerald"
    },
    {
      "text": "The wings are protected by rain-repellent dust. As a result, this POKéMON can fly about even in rain.",
      "version": "firered"
    },
    {
      "text": "In battle, it flaps its wings at great speed to release highly toxic dust into the air.",
      "version": "leafgreen"
    },
    {
      "text": "It loves the honey of flowers and can locate flower patches that have even tiny amounts of pollen.",
      "version": "diamond"
    },
    {
