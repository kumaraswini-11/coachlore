  "category": "Ice Chunk Pokémon",
  "entries": [
    {
      "text": "It blocks opponents’ attacks with the ice that shields its body. It uses cold air to repair any cracks with new ice.",
      "version": "x"
    },
    {
      "text": "Using air of -150 degrees Fahrenheit, they freeze opponents solid. They live in herds above the snow line on mountains.",
      "version": "y"
    },
    {
      "text": "It blocks opponents’ attacks with the ice that shields its body. It uses cold air to repair any cracks with new ice.",
      "version": "omega-ruby"
    },
    {
      "text": "Using air of -150 degrees Fahrenheit, they freeze opponents solid. They live in herds above the snow line on mountains.",
      "version": "alpha-sapphire"
    },
    {
      "text": "They chill the air around them to −150 degrees Fahrenheit, freezing the water in the air into ice that they use as armor.",
      "version": "sword"
    },
    {
      "text": "This Pokémon lives in areas of frigid cold. It secures itself to the back of an Avalugg by freezing its feet in place.",
      "version": "shield"
    },
    {
      "text": "Lives on mountains blanketed in perennial snow. It freezes water vapor in the air to make the ice helmet that it dons for defense.",
      "version": "legends-arceus"
    }
  ],
