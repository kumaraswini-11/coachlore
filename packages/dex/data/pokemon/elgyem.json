    {
      "text": "It uses its strong psychic power to squeeze its opponent’s brain, causing unendurable headaches.",
      "version": "omega-ruby"
    },
    {
      "text": "Rumors of its origin are linked to a UFO crash site in the desert 50 years ago.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It controls tremendous psychic power. Most reports of alien sightings are actually just people mistaking Elgyem for an alien.",
      "version": "ultra-sun"
    },
    {
      "text": "This Pokémon is shrouded in mystery. It’s said to have appeared from a UFO that fell from the sky about 50 years ago.",
      "version": "ultra-moon"
    },
    {
      "text": "If this Pokémon stands near a TV, strange scenery will appear on the screen. That scenery is said to be from its home.",
      "version": "sword"
    },
    {
      "text": "This Pokémon was discovered about 50 years ago. Its highly developed brain enables it to exert its psychic powers.",
      "version": "shield"
    }
