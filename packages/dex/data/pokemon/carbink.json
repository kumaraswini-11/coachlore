{
  "category": "Jewel Pokémon",
  "entries": [
    {
      "text": "Born from the temperatures and pressures deep underground, it fires beams from the stone in its head.",
      "version": "x"
    },
    {
      "text": "It has slept underground for hundreds of millions of years since its birth. It’s occasionally found during the excavation of caves.",
      "version": "y"
    },
    {
      "text": "Born from the temperatures and pressures deep underground, it fires beams from the stone in its head.",
      "version": "omega-ruby"
    },
    {
      "text": "It has slept underground for hundreds of millions of years since its birth. It’s occasionally found during the excavation of caves.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Born from the high temperatures and pressures deep underground, it defends itself by firing beams from the jewel part of its body.",
      "version": "sun"
    },
    {
      "text": "Although this Pokémon is not especially rare, its glittering, jewel-draped body draws attention from people.",
      "version": "moon"
    },
    {
      "text": "Some say that deep beneath the surface of the world, a pack of Carbink live with their queen in a kingdom of jewels.",
      "version": "ultra-sun"
    },
    {
      "text": "To keep the jewels on their bodies free of tarnish, packs of Carbink use their soft manes to polish one another’s jewels.",
      "version": "ultra-moon"
    },
    {
      "text": "When beset by attackers, Carbink wipes them all out by firing high-energy beams from the gems embedded in its body.",
      "version": "sword"
    },
    {
      "text": "It’s said that somewhere in the world, there’s a mineral vein housing a large pack of slumbering Carbink. It’s also said that this pack has a queen.",
      "version": "shield"
    }
  ],
