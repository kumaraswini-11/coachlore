{
  "category": "Pumpkin Pokémon",
  "entries": [
    {
      "text": "The pumpkin body is inhabited by a spirit trapped in this world. As the sun sets, it becomes restless and active.",
      "version": "x"
    },
    {
      "text": "It is said to carry wandering spirits to the place where they belong so they can move on.",
      "version": "y"
    },
    {
      "text": "The pumpkin body is inhabited by a spirit trapped in this world. As the sun sets, it becomes restless and active.",
      "version": "omega-ruby"
    },
    {
      "text": "It is said to carry wandering spirits to the place where they belong so they can move on.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Spirits that wander this world are placed into Pumpkaboo’s body. They’re then moved on to the afterlife.",
      "version": "sword"
    },
    {
      "text": "The light that streams out from the holes in the pumpkin can hypnotize and control the people and Pokémon that see it.",
      "version": "shield"
    }
  ],
