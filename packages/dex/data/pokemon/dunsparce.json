{
  "category": "Land Snake Pokémon",
  "entries": [
    {
      "text": "When spotted, this POKéMON escapes backward by furi ously boring into the ground with its tail.",
      "version": "gold"
    },
    {
      "text": "If spotted, it escapes by burrowing with its tail. It can float just slightly using its wings.",
      "version": "silver"
    },
    {
      "text": "It hides deep inside caves where no light ever reaches it and remains virtually motionless there.",
      "version": "crystal"
    },
    {
      "text": "DUNSPARCE has a drill for its tail. It uses this tail to burrow into the ground backwards. This POKéMON is known to make its nest in complex shapes deep under the ground.",
      "version": "ruby"
    },
    {
      "text": "DUNSPARCE has a drill for its tail. It uses this tail to burrow into the ground backwards. This POKéMON is known to make its nest in complex shapes deep under the ground.",
      "version": "sapphire"
    },
    {
      "text": "Its drill-tipped tail is used to burrow into the ground backwards. This POKéMON is known to make its nest in complex shapes deep under the ground.",
      "version": "emerald"
    },
    {
      "text": "If spotted, it escapes by burrowing with its tail. It can hover just slightly using its wings.",
      "version": "firered"
    },
    {
      "text": "When spotted, this POKéMON escapes backward by furiously boring into the ground with its tail.",
      "version": "leafgreen"
    },
    {
      "text": "It digs into the ground with its tail and makes a mazelike nest. It can fly just a little.",
