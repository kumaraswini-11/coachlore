{
  "category": "Bugle Beak Pokémon",
  "entries": [
    {
      "text": "It eats berries and stores their seeds in its beak. When it encounters enemies or prey, it fires off all the seeds in a burst.",
      "version": "sun"
    },
    {
      "text": "By bending its beak, it can produce a variety of calls and brand itself a noisy nuisance for its neighbors.",
      "version": "moon"
    },
    {
      "text": "It can bend the tip of its beak to produce over a hundred different cries at will.",
      "version": "ultra-sun"
    },
    {
      "text": "From its mouth, it fires the seeds of berries it has eaten. The scattered seeds give rise to new plants.",
      "version": "ultra-moon"
    }
  ],
