{
  "category": "Sand Heap Pokémon",
  "entries": [
    {
      "text": "Born from a sand mound playfully built by a child, this Pokémon embodies the grudges of the departed.",
      "version": "sun"
    },
    {
      "text": "It takes control of anyone who puts a hand in its mouth. And so it adds to the accumulation of its sand-mound body.",
      "version": "moon"
    },
    {
      "text": "It likes the shovel on its head, so Sandygast will get serious and fight any children who come to take it back.",
      "version": "ultra-sun"
    },
    {
      "text": "If you build sand mounds when you’re playing, destroy them before you go home, or they may get possessed and become Sandygast.",
      "version": "ultra-moon"
    },
    {
      "text": "Grudges of the dead have possessed a mound of sand and become a Pokémon. Sandygast is fond of the shovel on its head.",
      "version": "sword"
    },
    {
      "text": "Sandygast mainly inhabits beaches. It takes control of anyone who puts their hand into its mouth, forcing them to make its body bigger.",
      "version": "shield"
    }
  ],
