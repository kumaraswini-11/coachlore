  "entries": [
    {
      "text": "Its wings are too tiny to allow it to fly. As the time approaches for it to evolve, it discards the bones it was wearing.",
      "version": "black"
    },
    {
      "text": "They tend to guard their posteriors with suitable bones they have found. They pursue weak Pokémon.",
      "version": "white"
    },
    {
      "text": "Their wings are too tiny to allow them to fly. They guard their posteriors with bones that were gathered by Mandibuzz.",
