{
  "category": "Pig Pokémon",
  "entries": [
    {
      "text": "It rubs its snout on the ground to find and dig up food. It sometimes discovers hot springs.",
      "version": "gold"
    },
    {
      "text": "If it smells something enticing, it dashes headlong off to find the source of the aroma.",
      "version": "silver"
    },
    {
      "text": "It uses the tip of its nose to dig for food. Its nose is so tough that even frozen ground poses no problem.",
      "version": "crystal"
    },
    {
      "text": "SWINUB roots for food by rubbing its snout against the ground. Its favorite food is a mushroom that grows under the cover of dead grass. This POKéMON occasionally roots out hot springs.",
      "version": "ruby"
    },
    {
      "text": "SWINUB roots for food by rubbing its snout against the ground. Its favorite food is a mushroom that grows under the cover of dead grass. This POKéMON occasionally roots out hot springs.",
      "version": "sapphire"
    },
    {
      "text": "It roots for food by rubbing its snout against the ground. Its favorite food is a mushroom that grows under dried grass. It occasionally roots out hot springs.",
      "version": "emerald"
    },
    {
      "text": "If it smells something enticing, it dashes off headlong to find the source of the aroma.",
      "version": "firered"
