{
  "category": "Collective Pokémon",
  "entries": [
    {
      "text": "When they evolve, two Binacle multiply into seven. They fight with the power of seven Binacle.",
      "version": "x"
    },
    {
      "text": "Barbaracle’s legs and hands have minds of their own, and they will move independently. But they usually follow the head’s orders.",
      "version": "y"
    },
    {
      "text": "When they evolve, two Binacle multiply into seven. They fight with the power of seven Binacle.",
      "version": "omega-ruby"
    },
    {
      "text": "Barbaracle’s legs and hands have minds of their own, and they will move independently. But they usually follow the head’s orders.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Seven Binacle come together to form one Barbaracle. The Binacle that serves as the head gives orders to those serving as the limbs.",
      "version": "sword"
    },
    {
      "text": "Having an eye on each palm allows it to keep watch in all directions. In a pinch, its limbs start to act on their own to ensure the enemy’s defeat.",
      "version": "shield"
    }
  ],
