{
  "category": "Luring Pokémon",
  "entries": [
    {
      "text": "It absorbs a spirit, which it then burns. By waving the flames on its arms, it puts its foes into a hypnotic trance.",
      "version": "black"
    },
    {
      "text": "Being consumed in Chandelure’s flame burns up the spirit, leaving the body behind.",
      "version": "white"
    },
    {
      "text": "The spirits burned up in its ominous flame lose their way and wander this world forever.",
      "version": "black-2"
    },
    {
      "text": "The spirits burned up in its ominous flame lose their way and wander this world forever.",
      "version": "white-2"
    },
