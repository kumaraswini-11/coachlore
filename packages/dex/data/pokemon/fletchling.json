{
  "category": "Tiny Robin Pokémon",
  "entries": [
    {
      "text": "These friendly Pokémon send signals to one another with beautiful chirps and tail-feather movements.",
      "version": "x"
    },
    {
      "text": "Despite the beauty of its lilting voice, it’s merciless to intruders that enter its territory.",
      "version": "y"
    },
    {
      "text": "These friendly Pokémon send signals to one another with beautiful chirps and tail-feather movements.",
      "version": "omega-ruby"
    },
    {
      "text": "Despite the beauty of its lilting voice, it’s merciless to intruders that enter its territory.",
      "version": "alpha-sapphire"
    },
    {
      "text": "This amiable Pokémon is easy to train. But when battle is joined, it shows its ferocious side.",
      "version": "sun"
    },
    {
      "text": "When it’s excited, its temperature can double, spiking hormone production in its body.",
      "version": "moon"
    },
    {
      "text": "While it’s an amiable Pokémon, if you touch it unexpectedly, it will heat up its body in an instant, and you’ll be burned.",
      "version": "ultra-sun"
    },
    {
      "text": "Its body is always warm. Trainers who live in cold areas apparently sleep with it in their bed.",
      "version": "ultra-moon"
    },
    {
      "text": "Its melodious cries are actually warnings. Fletchling will mercilessly peck at anything that enters its territory.",
      "version": "sword"
    },
    {
      "text": "When this Pokémon gets excited, its body temperature increases sharply. If you touch a Fletchling with bare hands, you might get burned.",
      "version": "shield"
    }
  ],
