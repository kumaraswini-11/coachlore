{
  "category": "Dream Eater Pokémon",
  "entries": [
    {
      "text": "Munna always float in the air. People whose dreams are eaten by them forget what the dreams had been about.",
      "version": "black"
    },
    {
      "text": "It eats the dreams of people and Pokémon. When it eats a pleasant dream, it expels pink-colored mist.",
      "version": "white"
    },
    {
      "text": "This Pokémon appears before people and Pokémon who are having nightmares and eats those dreams.",
      "version": "black-2"
    },
    {
      "text": "This Pokémon appears before people and Pokémon who are having nightmares and eats those dreams.",
      "version": "white-2"
    },
    {
      "text": "This Pokémon appears before people and Pokémon who are having nightmares and eats those dreams.",
      "version": "x"
    },
    {
      "text": "It eats the dreams of people and Pokémon. When it eats a pleasant dream, it expels pink-colored mist.",
      "version": "y"
    },
    {
      "text": "This Pokémon appears before people and Pokémon who are having nightmares and eats those dreams.",
      "version": "omega-ruby"
    },
    {
      "text": "It eats the dreams of people and Pokémon. When it eats a pleasant dream, it expels pink-colored mist.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Late at night, it appears beside people’s pillows. As it feeds on dreams, the patterns on its body give off a faint glow.",
      "version": "sword"
    },
    {
      "text": "It eats dreams and releases mist. The mist is pink when it’s eating a good dream, and black when it’s eating a nightmare.",
      "version": "shield"
    }
  ],
