{
  "category": "Mold Pokémon",
  "entries": [
    {
      "text": "The BERRIES it stores in its vase-like shell decompose and become a gooey liquid.",
      "version": "gold"
    },
    {
      "text": "It stores BERRIES inside its shell. To avoid attacks, it hides beneath rocks and remains completely still.",
      "version": "silver"
    },
    {
      "text": "The fluid secreted by its toes carves holes in rocks for nesting and can be mixed with BERRIES to make a drink.",
      "version": "crystal"
    },
    {
      "text": "SHUCKLE quietly hides itself under rocks, keeping its body concealed inside its hard shell while eating berries it has stored away. The berries mix with its body fluids to become a juice.",
      "version": "ruby"
    },
    {
      "text": "SHUCKLE quietly hides itself under rocks, keeping its body concealed inside its hard shell while eating berries it has stored away. The berries mix with its body fluids to become a juice.",
