{
  "category": "String Spit Pokémon",
  "entries": [
    {
      "text": "It lies still in the same pose for days in its web, waiting for its unsuspecting prey to wander close.",
      "version": "gold"
    },
    {
      "text": "It spins a web using fine--but durable--thread. It then waits patiently for prey to be trapped.",
      "version": "silver"
    },
    {
      "text": "If prey becomes ensnared in its nest of spun string, it waits motionlessly until it becomes dark.",
      "version": "crystal"
    },
    {
      "text": "The web spun by SPINARAK can be considered its second nervous system. It is said that this POKéMON can determine what kind of prey is touching its web just by the tiny vibrations it feels through the web’s strands.",
      "version": "ruby"
    },
    {
      "text": "The web spun by SPINARAK can be considered its second nervous system. It is said that this POKéMON can determine what kind of prey is touching its web just by the tiny vibrations it feels through the web’s strands.",
      "version": "sapphire"
    },
    {
      "text": "The web it spins can be considered its second nervous system. It is said that a SPINARAK determines its prey by the tiny vibrations it feels through the web.",
      "version": "emerald"
    },
    {
      "text": "It spins a web using fine--but durable-- thread. It then waits patiently for prey to be trapped.",
      "version": "firered"
    },
    {
      "text": "It lies still in the same pose for days in its web, waiting for its unsuspecting prey to wander close.",
      "version": "leafgreen"
    },
    {
      "text": "It sets a trap by spinning a web with thin but strong silk. It waits motionlessly for prey to arrive.",
      "version": "diamond"
