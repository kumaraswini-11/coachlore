{
  "category": "Head Butt Pokémon",
  "entries": [
    {
      "text": "It lived in jungles around 100 million years ago. Its skull is as hard as iron.",
      "version": "diamond"
    },
    {
      "text": "It was resurrected from an iron ball-like fossil. It downs prey with its head butts.",
      "version": "pearl"
    },
    {
      "text": "A lifelong jungle dweller from 100 million years ago, it would snap obstructing trees with head butts.",
      "version": "platinum"
    },
    {
      "text": "CRANIDOS toughen up their already rock-hard heads by headbutting one another.",
      "version": "heartgold"
    },
