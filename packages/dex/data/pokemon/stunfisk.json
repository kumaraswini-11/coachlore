{
  "category": "Trap Pokémon",
  "entries": [
    {
      "text": "Its skin is very hard, so it is unhurt even if stepped on by sumo wrestlers. It smiles when transmitting electricity.",
      "version": "black"
    },
    {
      "text": "It conceals itself in the mud of the seashore. Then it waits. When prey touch it, it delivers a jolt of electricity.",
      "version": "white"
    },
    {
      "text": "When its opponent can’t be paralyzed, it contorts itself with unexpected speed and flops away.",
      "version": "black-2"
    },
    {
      "text": "When its opponent can’t be paralyzed, it contorts itself with unexpected speed and flops away.",
      "version": "white-2"
    },
    {
      "text": "Its skin is very hard, so it is unhurt even if stepped on by sumo wrestlers. It smiles when transmitting electricity.",
      "version": "x"
    },
    {
      "text": "It conceals itself in the mud of the seashore. Then it waits. When prey touch it, it delivers a jolt of electricity.",
      "version": "y"
    },
    {
      "text": "Its skin is very hard, so it is unhurt even if stepped on by sumo wrestlers. It smiles when transmitting electricity.",
      "version": "omega-ruby"
    },
    {
      "text": "It conceals itself in the mud of the seashore. Then it waits. When prey touch it, it delivers a jolt of electricity.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Thanks to bacteria that lived in the mud flats with it, this Pokémon developed the organs it uses to generate electricity.",
      "version": "sword"
    },
    {
      "text": "For some reason, this Pokémon smiles slightly when it emits a strong electric current from the yellow markings on its body.",
      "version": "shield"
    }
  ],
