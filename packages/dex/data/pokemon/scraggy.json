{
  "category": "Shedding Pokémon",
  "entries": [
    {
      "text": "Its skin has a rubbery elasticity, so it can reduce damage by defensively pulling its skin up to its neck.",
      "version": "black"
    },
    {
      "text": "It immediately headbutts anyone that makes eye contact with it. Its skull is massively thick.",
      "version": "white"
    },
    {
      "text": "Proud of its sturdy skull, it suddenly headbutts everything, but its weight makes it unstable, too.",
      "version": "black-2"
    },
    {
      "text": "Proud of its sturdy skull, it suddenly headbutts everything, but its weight makes it unstable, too.",
      "version": "white-2"
    },
    {
      "text": "Its skin has a rubbery elasticity, so it can reduce damage by defensively pulling its skin up to its neck.",
      "version": "x"
    },
    {
      "text": "Proud of its sturdy skull, it suddenly headbutts everything, but its weight makes it unstable, too.",
      "version": "y"
    },
    {
      "text": "Its skin has a rubbery elasticity, so it can reduce damage by defensively pulling its skin up to its neck.",
      "version": "omega-ruby"
    },
    {
      "text": "Proud of its sturdy skull, it suddenly headbutts everything, but its weight makes it unstable, too.",
      "version": "alpha-sapphire"
    },
    {
      "text": "They move in small groups, walking around lazily. Anyone who makes eye contact gets smacked with a headbutt.",
      "version": "ultra-sun"
    },
    {
      "text": "It stretches its saggy skin up to its neck to protect itself. The saggier their skin, the more respect they garner.",
      "version": "ultra-moon"
    },
    {
      "text": "If it locks eyes with you, watch out! Nothing and no one is safe from the reckless headbutts of this troublesome Pokémon.",
      "version": "sword"
    },
    {
      "text": "It protects itself with its durable skin. It’s thought that this Pokémon will evolve once its skin has completely stretched out.",
      "version": "shield"
    }
  ],
