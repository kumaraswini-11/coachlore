{
  "category": "Sea Weasel Pokémon",
  "entries": [
    {
      "text": "It has a flotation sac that is like an inflatable collar. It floats on water with its head out.",
      "version": "diamond"
    },
    {
      "text": "It swims by rotating its two tails like a screw. When it dives, its flotation sac collapses.",
      "version": "pearl"
    },
    {
      "text": "It spins its two tails like a screw to propel itself through water. The tails also slice clinging seaweed.",
      "version": "platinum"
    },
    {
      "text": "It inflates its flotation sac, keeping its face above water in order to watch for prey movement.",
      "version": "heartgold"
    },
    {
      "text": "It inflates its flotation sac, keeping its face above water in order to watch for prey movement.",
      "version": "soulsilver"
    },
    {
      "text": "It spins its two tails like a screw to propel itself through water. The tails also slice clinging seaweed.",
      "version": "black"
    },
    {
      "text": "It spins its two tails like a screw to propel itself through water. The tails also slice clinging seaweed.",
      "version": "white"
    },
    {
      "text": "It inflates the flotation sac around its neck and pokes its head out of the water to see what is going on.",
      "version": "black-2"
    },
    {
      "text": "It inflates the flotation sac around its neck and pokes its head out of the water to see what is going on.",
      "version": "white-2"
    },
    {
      "text": "It swims by rotating its two tails like a screw. When it dives, its flotation sac collapses.",
      "version": "x"
    },
    {
      "text": "It inflates the flotation sac around its neck and pokes its head out of the water to see what is going on.",
      "version": "y"
    },
    {
      "text": "It swims by rotating its two tails like a screw. When it dives, its flotation sac collapses.",
      "version": "omega-ruby"
    },
    {
      "text": "It inflates the flotation sac around its neck and pokes its head out of the water to see what is going on.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It moves freely in the water by spinning its forked tail for propulsion. The resemblance to the screw of a steamboat is coincidental.",
      "version": "legends-arceus"
    }
  ],
