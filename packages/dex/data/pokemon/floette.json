{
  "category": "Single Bloom Pokémon",
  "entries": [
    {
      "text": "It flutters around fields of flowers and cares for flowers that are starting to wilt. It draws out the hidden power of flowers to battle.",
      "version": "x"
    },
    {
      "text": "When the flowers of a well-tended flower bed bloom, it appears and celebrates with an elegant dance.",
      "version": "y"
    },
    {
      "text": "It flutters around fields of flowers and cares for flowers that are starting to wilt. It draws out the hidden power of flowers to battle.",
      "version": "omega-ruby"
    },
    {
      "text": "When the flowers of a well-tended flower bed bloom, it appears and celebrates with an elegant dance.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It raises flowers and uses them as weapons. The more gorgeous the blossom, the more power it contains.",
      "version": "ultra-sun"
    },
    {
      "text": "It gives its own power to flowers, pouring its heart into caring for them. Floette never forgives anyone who messes up a flower bed.",
      "version": "ultra-moon"
    }
  ],
