    {
      "text": "A Pokémon that lives on icebergs. It swims in the sea using the point on its head to break up ice.",
      "version": "black"
    },
    {
      "text": "A Pokémon that lives on icebergs. It swims in the sea using the point on its head to break up ice.",
      "version": "white"
    },
    {
      "text": "The colder it gets, the better it feels. It joyfully swims around oceans so cold that they are filled with floating ice.",
      "version": "black-2"
    },
    {
      "text": "The colder it gets, the better it feels. It joyfully swims around oceans so cold that they are filled with floating ice.",
      "version": "white-2"
    },
    {
      "text": "A Pokémon that lives on icebergs. It swims in the sea using the point on its head to break up ice.",
      "version": "x"
    },
    {
      "text": "Covered with light blue fur, its hide is thick and tough. It is active in bitter cold of -40 degrees Fahrenheit.",
      "version": "y"
    },
    {
      "text": "Seel hunts for prey in the frigid sea underneath sheets of ice. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head.",
      "version": "omega-ruby"
    },
    {
      "text": "Seel hunts for prey in the frigid sea underneath sheets of ice. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It has always been supposed that Seel live only in cold seas. Their having shown up in Alola is a mystery.",
      "version": "ultra-sun"
    },
    {
      "text": "Thanks to its thick fat, cold seas don’t bother it at all, but it gets tired pretty easily in warm waters.",
      "version": "ultra-moon"
    },
    {
      "text": "Loves freezing-cold conditions. Relishes swimming in a frigid climate of around 14 degrees Fahrenheit.",
      "version": "lets-go-pikachu"
    },
    {
      "text": "Loves freezing-cold conditions. Relishes swimming in a frigid climate of around 14 degrees Fahrenheit.",
      "version": "lets-go-eevee"
    }
