{
  "category": "Sea Lion Pokémon",
  "entries": [
    {
      "text": "The protruding horn on its head is very hard. It is used for bashing through thick ice.",
      "version": "red"
    },
    {
      "text": "The protruding horn on its head is very hard. It is used for bashing through thick ice.",
      "version": "blue"
    },
    {
      "text": "Loves freezing cold conditions. Relishes swimming in a frigid climate of around 14F degrees.",
      "version": "yellow"
    },
    {
      "text": "Although it can't walk well on land, it is a graceful swimmer. It especially loves being in frigid seas.",
      "version": "gold"
    },
    {
      "text": "In daytime, it is often found asleep on the seabed in shallow waters. Its nostrils close while it swims.",
      "version": "silver"
    },
    {
      "text": "The light blue fur that covers it keeps it protected against the cold. It loves iceberg- filled oceans.",
      "version": "crystal"
    },
    {
      "text": "SEEL hunts for prey in the frigid sea underneath sheets of ice. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head.",
      "version": "ruby"
    },
    {
      "text": "SEEL hunts for prey in the frigid sea underneath sheets of ice. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head.",
      "version": "sapphire"
    },
    {
      "text": "SEEL hunt for prey in frigid, ice-covered seas. When it needs to breathe, it punches a hole through the ice with the sharply protruding section of its head.",
      "version": "emerald"
    },
    {
      "text": "Covered with light blue fur, its hide is thick and tough. It is active in bitter cold of minus 40 degrees Fahrenheit.",
      "version": "firered"
    },
    {
      "text": "The protruding horn on its head is very hard. It is used for bashing through thick icebergs.",
      "version": "leafgreen"
    },
    {
      "text": "A Pokémon that lives on icebergs. It swims in the sea using the point on its head to break up ice.",
      "version": "diamond"
    },
    {
      "text": "A Pokémon that lives on icebergs. It swims in the sea using the point on its head to break up ice.",
      "version": "pearl"
    },
    {
      "text": "A Pokémon that lives on icebergs. It swims in the sea using the point on its head to break up ice.",
      "version": "platinum"
    },
    {
      "text": "Although it can’t walk well on land, it is a graceful swimmer. It especially loves being in frigid seas.",
      "version": "heartgold"
    },
    {
      "text": "In daytime, it is often found asleep on the seabed in shallow waters. Its nostrils close while it swims.",
      "version": "soulsilver"
