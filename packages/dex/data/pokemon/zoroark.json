{
  "category": "Illusion Fox Pokémon",
  "entries": [
    {
      "text": "Bonds between these Pokémon are very strong. It protects the safety of its pack by tricking its opponents.",
      "version": "black"
    },
    {
      "text": "Each has the ability to fool a large group of people simultaneously. They protect their lair with illusory scenery.",
      "version": "white"
    },
    {
      "text": "Stories say those who tried to catch Zoroark were trapped in an illusion and punished.",
      "version": "black-2"
    },
    {
      "text": "Stories say those who tried to catch Zoroark were trapped in an illusion and punished.",
      "version": "white-2"
    },
    {
      "text": "Each has the ability to fool a large group of people simultaneously. They protect their lair with illusory scenery.",
      "version": "x"
    },
    {
      "text": "Bonds between these Pokémon are very strong. It protects the safety of its pack by tricking its opponents.",
      "version": "y"
    },
    {
      "text": "Each has the ability to fool a large group of people simultaneously. They protect their lair with illusory scenery.",
      "version": "omega-ruby"
    },
    {
      "text": "Bonds between these Pokémon are very strong. It protects the safety of its pack by tricking its opponents.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It doesn’t just transform itself—it also has the power to make hundreds of people see its illusions.",
      "version": "ultra-sun"
    },
    {
      "text": "If it thinks humans are going to discover its den, Zoroark shows them visions that make them wander around in the woods.",
      "version": "ultra-moon"
    },
    {
      "text": "This Pokémon cares deeply about others of its kind, and it will conjure terrifying illusions to keep its den and pack safe.",
      "version": "sword"
    },
    {
      "text": "Seeking to ease the burden of their solitude, lonely Trainers tell Zoroark to show illusions to them.",
      "version": "shield"
    },
    {
      "text": "With its disheveled white fur, it looks like an embodiment of death. Heedless of its own safety, Zoroark attacks its nemeses with a bitter energy so intense, it lacerates Zoroark's own body.",
      "version": "legends-arceus"
    }
  ],
