{
  "category": "Iceberg Pokémon",
  "entries": [
    {
      "text": "Its ice-covered body is as hard as steel. Its cumbersome frame crushes anything that stands in its way.",
      "version": "x"
    },
    {
      "text": "The way several Bergmite huddle on its back makes it look like an aircraft carrier made of ice.",
      "version": "y"
    },
    {
      "text": "Its ice-covered body is as hard as steel. Its cumbersome frame crushes anything that stands in its way.",
      "version": "omega-ruby"
    },
    {
      "text": "The way several Bergmite huddle on its back makes it look like an aircraft carrier made of ice.",
      "version": "alpha-sapphire"
    },
    {
      "text": "At high latitudes, this Pokémon can be found with clusters of Bergmite on its back as it swims among the icebergs.",
      "version": "sword"
    },
    {
      "text": "As Avalugg moves about during the day, the cracks in its body deepen. The Pokémon’s body returns to a pristine state overnight.",
      "version": "shield"
    },
    {
      "text": "The armor of ice covering its lower jaw puts steel to shame and can shatter rocks with ease. This Pokémon barrels along steep mountain paths, cleaving through the deep snow.",
      "version": "legends-arceus"
    }
  ],
