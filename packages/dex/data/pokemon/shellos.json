{
  "category": "Sea Slug Pokémon",
  "entries": [
    {
      "text": "Its colors and shapes differ from region to region. In the Sinnoh region, two types are confirmed.",
      "version": "diamond"
    },
    {
      "text": "It lives along bodies of water. Its body shape has changed to suit its habitat.",
      "version": "pearl"
    },
    {
      "text": "Beware of pushing strongly on its squishy body, as it makes a mysterious purple fluid ooze out.",
      "version": "platinum"
    },
    {
      "text": "Its shape and coloration vary, depending on its habitat.",
      "version": "heartgold"
    },
    {
