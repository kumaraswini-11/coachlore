{
  "category": "Drowsing Pokémon",
  "entries": [
    {
      "text": "The mist emanating from their foreheads is packed with the dreams of people and Pokémon.",
      "version": "black"
    },
    {
      "text": "With the mist from its forehead, it can create shapes of things from dreams it has eaten.",
      "version": "white"
    },
    {
      "text": "The dream mist coming from its forehead changes into many different colors depending on the dream that was eaten.",
      "version": "black-2"
    },
    {
      "text": "The dream mist coming from its forehead changes into many different colors depending on the dream that was eaten.",
      "version": "white-2"
    },
    {
      "text": "The mist emanating from their foreheads is packed with the dreams of people and Pokémon.",
      "version": "x"
    },
    {
      "text": "The dream mist coming from its forehead changes into many different colors depending on the dream that was eaten.",
      "version": "y"
    },
    {
      "text": "The mist emanating from their foreheads is packed with the dreams of people and Pokémon.",
      "version": "omega-ruby"
    },
    {
      "text": "The dream mist coming from its forehead changes into many different colors depending on the dream that was eaten.",
      "version": "alpha-sapphire"
    },
    {
      "text": "When dark mists emanate from its body, don’t get too near. If you do, your nightmares will become reality.",
      "version": "sword"
    },
    {
      "text": "It drowses and dreams all the time. It’s best to leave it be if it’s just woken up, as it’s a terrible grump when freshly roused from sleep.",
      "version": "shield"
    }
  ],
