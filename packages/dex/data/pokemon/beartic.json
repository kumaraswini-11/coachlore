{
  "category": "Freezing Pokémon",
  "entries": [
    {
      "text": "It can make its breath freeze at will. Very able in the water, it swims around in northern seas and catches prey.",
      "version": "black"
    },
    {
      "text": "It freezes its breath to create fangs and claws of ice to fight with. Cold northern areas are its habitat.",
      "version": "white"
    },
    {
      "text": "They love the cold seas of the north. They create pathways across the ocean waters by freezing their own breath.",
      "version": "black-2"
    },
    {
      "text": "They love the cold seas of the north. They create pathways across the ocean waters by freezing their own breath.",
      "version": "white-2"
    },
    {
      "text": "They love the cold seas of the north. They create pathways across the ocean waters by freezing their own breath.",
      "version": "x"
    },
    {
      "text": "It freezes its breath to create fangs and claws of ice to fight with. Cold northern areas are its habitat.",
      "version": "y"
    },
    {
      "text": "They love the cold seas of the north. They create pathways across the ocean waters by freezing their own breath.",
      "version": "omega-ruby"
    },
    {
      "text": "It freezes its breath to create fangs and claws of ice to fight with. Cold northern areas are its habitat.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It swims through frigid seas, searching for prey. From its frozen breath, it forms icy fangs that are harder than steel.",
      "version": "sword"
    },
    {
      "text": "It swims energetically through frigid seas. When it gets tired, it freezes the seawater with its breath so it can rest on the ice.",
      "version": "shield"
    }
  ],
