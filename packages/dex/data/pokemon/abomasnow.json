{
  "category": "Frost Tree Pokémon",
  "entries": [
    {
      "text": "It whips up blizzards in mountains that are always buried in snow. It is the abominable snowman.",
      "version": "diamond"
    },
    {
      "text": "It blankets wide areas in snow by whipping up blizzards. It is also known as “The Ice Monster.”",
      "version": "pearl"
    },
    {
      "text": "They appear when the snow flowers bloom. When the petals fall, they retreat to places unknown again.",
      "version": "platinum"
    },
    {
      "text": "It lives a quiet life on mountains that are perpetually covered in snow. It hides itself by whipping up blizzards.",
      "version": "heartgold"
    },
