  "entries": [
    {
      "text": "This Pokémon was believed to have been born from the sun. When it evolves, its entire body is engulfed in flames.",
      "version": "black"
    },
    {
      "text": "The base of volcanoes is where they make their homes. They shoot fire from their five horns to repel attacking enemies.",
      "version": "white"
