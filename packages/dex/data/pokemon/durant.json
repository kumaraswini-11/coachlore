{
  "category": "Iron Ant Pokémon",
  "entries": [
    {
      "text": "They attack in groups, covering themselves in steel armor to protect themselves from Heatmor.",
      "version": "black"
    },
    {
      "text": "Durant dig nests in mountains. They build their complicated, interconnected tunnels into mazes.",
      "version": "white"
    },
    {
      "text": "Individuals each play different roles in driving Heatmor, their natural predator, away from their colony.",
      "version": "black-2"
    },
    {
      "text": "Individuals each play different roles in driving Heatmor, their natural predator, away from their colony.",
      "version": "white-2"
    },
    {
      "text": "Individuals each play different roles in driving Heatmor, their natural predator, away from their colony.",
      "version": "x"
    },
    {
      "text": "They attack in groups, covering themselves in steel armor to protect themselves from Heatmor.",
      "version": "y"
    },
    {
      "text": "Individuals each play different roles in driving Heatmor, their natural predator, away from their colony.",
      "version": "omega-ruby"
    },
    {
      "text": "They attack in groups, covering themselves in steel armor to protect themselves from Heatmor.",
      "version": "alpha-sapphire"
    },
    {
      "text": "They lay their eggs deep inside their nests. When attacked by Heatmor, they retaliate using their massive mandibles.",
      "version": "sword"
    },
    {
      "text": "With their large mandibles, these Pokémon can crunch their way through rock. They work together to protect their eggs from Sandaconda.",
      "version": "shield"
    }
