{
  "category": "Illuminating Pokémon",
  "entries": [
    {
      "text": "Forests where Shiinotic live are treacherous to enter at night. People confused by its strange lights can never find their way home again.",
      "version": "sun"
    },
    {
      "text": "It emits flickering spores that cause drowsiness. When its prey succumb to sleep, this Pokémon feeds on them by sucking in their energy.",
      "version": "moon"
    },
    {
      "text": "It puts its prey to sleep and siphons off their vitality through the tip of its arms. If one of its kind is weakened, it helps by sending it vitality.",
      "version": "ultra-sun"
    },
    {
      "text": "When it starts fighting for territory with Parasect, the entire area gets completely coated in spores!",
      "version": "ultra-moon"
    },
    {
      "text": "Its flickering spores lure in prey and put them to sleep. Once this Pokémon has its prey snoozing, it drains their vitality with its fingertips.",
      "version": "sword"
    },
    {
      "text": "If you see a light deep in a forest at night, don’t go near. Shiinotic will make you fall fast asleep.",
      "version": "shield"
    }
  ],
