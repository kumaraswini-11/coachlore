{
  "category": "Revolving Pokémon",
  "entries": [
    {
      "text": "Opponents who stare at the flashing of the light-emitting spots on its body become dazed and lose their will to fight.",
      "version": "x"
    },
    {
      "text": "It flashes the light-emitting spots on its body, which drains its opponent’s will to fight. It takes the opportunity to scuttle away and hide.",
      "version": "y"
    },
    {
      "text": "Opponents who stare at the flashing of the light-emitting spots on its body become dazed and lose their will to fight.",
      "version": "omega-ruby"
    },
    {
      "text": "It flashes the light-emitting spots on its body, which drains its opponent’s will to fight. It takes the opportunity to scuttle away and hide.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It draws prey near with its blinking lights and then wraps them up in its long tentacles and holds them in place.",
      "version": "ultra-sun"
    },
    {
      "text": "When exchanging information with others of its kind, it flashes the light-emitting spots on its body in a complex rhythm.",
      "version": "ultra-moon"
    },
    {
      "text": "It spins while making its luminescent spots flash. These spots allow it to communicate with others by using different patterns of light.",
      "version": "sword"
    },
    {
      "text": "By exposing foes to the blinking of its luminescent spots, Inkay demoralizes them, and then it seizes the chance to flee.",
      "version": "shield"
    }
  ],
