  "entries": [
    {
      "text": "Its abdomen is a honeycomb for grubs. It raises its grubs on honey collected by COMBEE.",
      "version": "diamond"
    },
    {
      "text": "When endangered, grubs from its six-cell honeycomb strike back. There is only one in a colony.",
      "version": "pearl"
    },
    {
      "text": "It releases various pheromones to make the grubs in its body do its bidding while fighting foes.",
      "version": "platinum"
    },
    {
      "text": "It raises grubs in the holes in its body. It secretes pheromones to control COMBEE.",
      "version": "heartgold"
