{
  "category": "Placid Pokémon",
  "entries": [
    {
      "text": "It has a compassionate personality, but if it is angered, it completely destroys its surroundings with its intense breath.",
      "version": "sun"
    },
    {
      "text": "This Pokémon is friendly to people and loves children most of all. It comes from deep in the mountains to play with children it likes in town.",
      "version": "moon"
    },
    {
      "text": "If a child it has made friends with is bullied, Drampa will find the bully’s house and burn it to the ground.",
      "version": "ultra-sun"
    },
    {
      "text": "It appears in towns and plays with the children. Drampa will protect kids when they’re in danger, so their moms don’t have to worry.",
      "version": "ultra-moon"
    },
    {
      "text": "The mountains it calls home are nearly two miles in height. On rare occasions, it descends to play with the children living in the towns below.",
      "version": "sword"
    },
    {
      "text": "Drampa is a kind and friendly Pokémon—up until it’s angered. When that happens, it stirs up a gale and flattens everything around.",
      "version": "shield"
    }
  ],
