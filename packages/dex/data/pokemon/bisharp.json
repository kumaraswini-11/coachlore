{
  "category": "Sword Blade Pokémon",
  "entries": [
    {
      "text": "It leads a group of Pawniard. It battles to become the boss, but will be driven from the group if it loses.",
      "version": "black"
    },
    {
      "text": "Bisharp pursues prey in the company of a large group of Pawniard. Then Bisharp finishes off the prey.",
      "version": "white"
    },
    {
      "text": "This pitiless Pokémon commands a group of Pawniard to hound prey into immobility. It then moves in to finish the prey off.",
      "version": "black-2"
    },
    {
      "text": "This pitiless Pokémon commands a group of Pawniard to hound prey into immobility. It then moves in to finish the prey off.",
      "version": "white-2"
    },
    {
      "text": "This pitiless Pokémon commands a group of Pawniard to hound prey into immobility. It then moves in to finish the prey off.",
      "version": "x"
    },
    {
      "text": "Bisharp pursues prey in the company of a large group of Pawniard. Then Bisharp finishes off the prey.",
      "version": "y"
    },
    {
      "text": "This pitiless Pokémon commands a group of Pawniard to hound prey into immobility. It then moves in to finish the prey off.",
      "version": "omega-ruby"
    },
    {
      "text": "Bisharp pursues prey in the company of a large group of Pawniard. Then Bisharp finishes off the prey.",
      "version": "alpha-sapphire"
    },
    {
      "text": "No matter how strong the Bisharp, it’s said that if the blade on its head is chipped, it will retire from its position as the boss.",
      "version": "ultra-sun"
    },
    {
      "text": "It leads a group of Pawniard. Bisharp doesn’t even change its expression when it deals the finishing blow to an opponent.",
      "version": "ultra-moon"
    },
    {
      "text": "It’s accompanied by a large retinue of Pawniard. Bisharp keeps a keen eye on its minions, ensuring none of them even think of double-crossing it.",
      "version": "sword"
    },
    {
      "text": "Violent conflicts erupt between Bisharp and Fraxure over places where sharpening stones can be found.",
      "version": "shield"
    }
  ],
