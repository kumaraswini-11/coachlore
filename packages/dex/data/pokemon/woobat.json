{
  "category": "Bat Pokémon",
  "entries": [
    {
      "text": "Its habitat is dark forests and caves. It emits ultrasonic waves from its nose to learn about its surroundings.",
      "version": "black"
    },
    {
      "text": "Suction from its nostrils enables it to stick to cave walls during sleep. It leaves a heart-shaped mark behind.",
      "version": "white"
    },
    {
      "text": "The heart-shaped mark left on a body after a Woobat has been attached to it is said to bring good fortune.",
      "version": "black-2"
    },
    {
      "text": "The heart-shaped mark left on a body after a Woobat has been attached to it is said to bring good fortune.",
      "version": "white-2"
    },
    {
      "text": "Its habitat is dark forests and caves. It emits ultrasonic waves from its nose to learn about its surroundings.",
      "version": "x"
    },
    {
      "text": "The heart-shaped mark left on a body after a Woobat has been attached to it is said to bring good fortune.",
      "version": "y"
    },
    {
      "text": "Its habitat is dark forests and caves. It emits ultrasonic waves from its nose to learn about its surroundings.",
      "version": "omega-ruby"
    },
    {
      "text": "The heart-shaped mark left on a body after a Woobat has been attached to it is said to bring good fortune.",
      "version": "alpha-sapphire"
    },
    {
      "text": "While inside a cave, if you look up and see lots of heart-shaped marks lining the walls, it’s evidence that Woobat live there.",
      "version": "sword"
    },
    {
      "text": "It emits ultrasonic waves as it flutters about, searching for its prey—bug Pokémon.",
      "version": "shield"
    }
  ],
