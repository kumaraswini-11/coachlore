{
  "category": "Bell Pokémon",
  "entries": [
    {
      "text": "It emits cries by agitating an orb at the back of its throat. It moves with flouncing hops.",
      "version": "diamond"
    },
    {
      "text": "Each time it hops, it makes a ringing sound. It deafens foes by emitting high-frequency cries.",
      "version": "pearl"
    },
    {
      "text": "There is an orb inside its mouth. When it hops, the orb bounces all over and makes a ringing sound.",
      "version": "platinum"
    },
    {
      "text": "It emits high-frequency cries that people can’t hear. Once it starts, it can cry for an awfully long time.",
      "version": "heartgold"
    },
    {
      "text": "It emits high-frequency cries that people can’t hear. Once it starts, it can cry for an awfully long time.",
      "version": "soulsilver"
