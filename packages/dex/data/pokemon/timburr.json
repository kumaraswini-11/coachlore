  "entries": [
    {
      "text": "It fights by swinging a piece of lumber around. It is close to evolving when it can handle the lumber without difficulty.",
      "version": "black"
    },
    {
      "text": "These Pokémon appear at building sites and help out with construction. They always carry squared logs.",
