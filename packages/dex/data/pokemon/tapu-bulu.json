{
  "category": "Land Spirit Pokémon",
  "entries": [
    {
      "text": "It pulls large trees up by the roots and swings them around. It causes vegetation to grow, and then it absorbs energy from the growth.",
      "version": "sun"
    },
    {
      "text": "The guardian deity of Ula’ula is a lazy Pokémon. It commands plants to immobilize its foes and then deals them a savage blow with its horns.",
      "version": "moon"
    },
    {
      "text": "Although it’s called a guardian deity, it’s violent enough to crush anyone it sees as an enemy.",
      "version": "ultra-sun"
    },
    {
      "text": "It makes ringing sounds with its tail to let others know where it is, avoiding unneeded conflicts. This guardian deity of Ula’ula controls plants.",
      "version": "ultra-moon"
    }
  ],
