{
  "category": "Toxic Lizard Pokémon",
  "entries": [
    {
      "text": "For some reason, only females have been found. It creates a reverse harem of male Salandit that it lives with.",
      "version": "sun"
    },
    {
      "text": "Filled with pheromones, its poisonous gas can be diluted to use in the production of luscious perfumes.",
      "version": "moon"
    },
    {
      "text": "Salazzle lives deep in caves and forces the Salandit it has attracted with its pheromones to serve it.",
      "version": "ultra-sun"
    },
    {
      "text": "It punishes Salandit that couldn’t bring it food with a fierce slap of its flame-spewing palm.",
      "version": "ultra-moon"
    },
    {
      "text": "Only female Salazzle exist. They emit a gas laden with pheromones to captivate male Salandit.",
      "version": "sword"
    },
    {
      "text": "The winner of competitions between Salazzle is decided by which one has the most male Salandit with it.",
      "version": "shield"
    }
  ],
