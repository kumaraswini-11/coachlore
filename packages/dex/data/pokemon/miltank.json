{
  "category": "Milk Cow Pokémon",
  "entries": [
    {
      "text": "Its milk is packed with nutrition, making it the ultimate beverage for the sick or weary.",
      "version": "gold"
    },
    {
      "text": "If it has just had a baby, the milk it produces con tains much more nutrition than usual.",
      "version": "silver"
    },
    {
      "text": "In order to milk a MILTANK, one must have a knack for rhythmically pulling up and down on its udders.",
      "version": "crystal"
    },
    {
      "text": "MILTANK gives over five gallons of milk on a daily basis. Its sweet milk is enjoyed by children and grown-ups alike. People who can’t drink milk turn it into yogurt and eat it instead.",
      "version": "ruby"
    },
    {
      "text": "MILTANK gives over five gallons of milk on a daily basis. Its sweet milk is enjoyed by children and grown-ups alike. People who can’t drink milk turn it into yogurt and eat it instead.",
