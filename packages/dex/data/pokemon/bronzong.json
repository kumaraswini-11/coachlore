{
  "category": "Bronze Bell Pokémon",
  "entries": [
    {
      "text": "One caused a news sensation when it was dug up at a construction site after a 2,000-year sleep.",
      "version": "diamond"
    },
    {
      "text": "It can summon rain clouds. People long ago revered it as the bringer of plentiful harvests.",
      "version": "pearl"
    },
    {
      "text": "It brought rains by opening portals to another world. It was revered as a bringer of plentiful harvests.",
      "version": "platinum"
    },
    {
      "text": "Ancient people believed that petitioning BRONZONG for rain was the way to make crops grow.",
      "version": "heartgold"
    },
    {
      "text": "Ancient people believed that petitioning BRONZONG for rain was the way to make crops grow.",
      "version": "soulsilver"
    },
    {
      "text": "It brought rains by opening portals to another world. It was revered as a bringer of plentiful harvests.",
      "version": "black"
    },
    {
      "text": "It brought rains by opening portals to another world. It was revered as a bringer of plentiful harvests.",
      "version": "white"
    },
    {
      "text": "In ages past, this Pokémon was revered as a bringer of rain. It was found buried in the ground.",
      "version": "black-2"
    },
    {
      "text": "In ages past, this Pokémon was revered as a bringer of rain. It was found buried in the ground.",
      "version": "white-2"
    },
    {
      "text": "In ages past, this Pokémon was revered as a bringer of rain. It was found buried in the ground.",
      "version": "x"
    },
    {
      "text": "Ancient people believed that petitioning Bronzong for rain was the way to make crops grow.",
      "version": "y"
    },
    {
      "text": "In ages past, this Pokémon was revered as a bringer of rain. It was found buried in the ground.",
      "version": "omega-ruby"
    },
    {
      "text": "Ancient people believed that petitioning Bronzong for rain was the way to make crops grow.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Some believe it to be a deity that summons rain clouds. When angered, it lets out a warning cry that rings out like the tolling of a bell.",
      "version": "sword"
    },
    {
      "text": "Many scientists suspect that this Pokémon originated outside the Galar region, based on the patterns on its body.",
      "version": "shield"
    },
    {
      "text": "Some believe that its bell-like cry opens holes to another world. It has been revered as a deity since ancient times.",
      "version": "legends-arceus"
    }
  ],
