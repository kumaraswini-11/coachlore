{
  "category": "Ruffian Pokémon",
  "entries": [
    {
      "text": "CORPHISH were originally foreign POKéMON that were imported as pets. They eventually turned up in the wild. This POKéMON is very hardy and has greatly increased its population.",
      "version": "ruby"
    },
    {
      "text": "CORPHISH catches prey with its sharp claws. It has no likes or dislikes when it comes to food - it will eat anything. This POKéMON has no trouble living in filthy water.",
      "version": "sapphire"
    },
    {
      "text": "Once it grips prey with its large pincers, it will never let go, no matter what. It is a hardy POKéMON that can thrive in any environment.",
      "version": "emerald"
    },
    {
      "text": "It came from overseas. It is a very hardy creature that will quickly proliferate, even in polluted streams.",
      "version": "firered"
    },
    {
      "text": "It came from overseas. It is a very hardy creature that will quickly proliferate, even in polluted streams.",
      "version": "leafgreen"
    },
    {
      "text": "Its hardy vitality enables it to adapt to any environment. Its pincers will never release prey.",
      "version": "diamond"
    },
    {
      "text": "Its hardy vitality enables it to adapt to any environment. Its pincers will never release prey.",
      "version": "pearl"
    },
    {
      "text": "Its hardy vitality enables it to adapt to any environment. Its pincers will never release prey.",
      "version": "platinum"
    },
    {
      "text": "It was originally a Pokémon from afar that escaped to the wild. It can adapt to the dirtiest river.",
      "version": "heartgold"
    },
    {
      "text": "It was originally a Pokémon from afar that escaped to the wild. It can adapt to the dirtiest river.",
      "version": "soulsilver"
