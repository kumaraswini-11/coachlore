{
  "category": "Cave Pokémon",
  "entries": [
    {
      "text": "There is a long-held belief that medicine made from its scales will heal even incurable illnesses.",
      "version": "diamond"
    },
    {
      "text": "It habitually digs up and hoards gems in its nest. Its loot is constantly targeted by thieves.",
      "version": "pearl"
    },
    {
      "text": "It loves sparkly things. It seeks treasures in caves and hoards the loot in its nest.",
      "version": "platinum"
    },
    {
      "text": "As it digs to expand its nest, it habitually digs up gems that it then hoards in its nest.",
      "version": "heartgold"
    },
    {
      "text": "As it digs to expand its nest, it habitually digs up gems that it then hoards in its nest.",
      "version": "soulsilver"
    },
