{
  "category": "Sound Wave Pokémon",
  "entries": [
    {
      "text": "They live in pitch-black caves. Their enormous ears can emit ultrasonic waves of 200,000 hertz.",
      "version": "x"
    },
    {
      "text": "Even a robust wrestler will become dizzy and unable to stand when exposed to its 200,000-hertz ultrasonic waves.",
      "version": "y"
    },
    {
      "text": "They live in pitch-black caves. Their enormous ears can emit ultrasonic waves of 200,000 hertz.",
      "version": "omega-ruby"
    },
    {
      "text": "Even a robust wrestler will become dizzy and unable to stand when exposed to its 200,000-hertz ultrasonic waves.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Fruits are its favorite foods. This gourmet carefully picks out just the ripe ones using its sonar.",
      "version": "ultra-sun"
    },
    {
      "text": "It flies around in search of fruit to eat. It uses ultrasonic waves to detect which fruits are ripe.",
      "version": "ultra-moon"
    },
    {
      "text": "After nightfall, they emerge from the caves they nest in during the day. Using their ultrasonic waves, they go on the hunt for ripened fruit.",
      "version": "sword"
    },
    {
      "text": "No wavelength of sound is beyond Noibat’s ability to produce. The ultrasonic waves it generates can overcome much larger Pokémon.",
      "version": "shield"
    }
  ],
