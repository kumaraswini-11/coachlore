{
  "category": "Land Spirit Pokémon",
  "entries": [
    {
      "text": "This guardian deity of Akala is guilelessly cruel. The fragrant aroma of flowers is the source of its energy.",
      "version": "sun"
    },
    {
      "text": "As it flutters about, it scatters its strangely glowing scales. Touching them is said to restore good health on the spot.",
      "version": "moon"
    },
    {
      "text": "It heals the wounds of people and Pokémon by sprinkling them with its sparkling scales. This guardian deity is worshiped on Akala.",
      "version": "ultra-sun"
    },
    {
      "text": "Although called a guardian deity, Tapu Lele is devoid of guilt about its cruel disposition and can be described as nature incarnate.",
      "version": "ultra-moon"
    }
  ],
