  "entries": [
    {
      "text": "It has eyes that can see through anything. It spots and captures prey hiding behind objects.",
      "version": "diamond"
    },
    {
      "text": "When its eyes gleam gold, it can spot hiding prey--even those taking shelter behind a wall.",
      "version": "pearl"
    },
    {
