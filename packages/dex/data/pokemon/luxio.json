    {
      "text": "Its claws loose electricity with enough amperage to cause fainting. They live in small groups.",
      "version": "diamond"
    },
    {
      "text": "It rests its forelegs on others to communicate with rhythmic electric pulses from its claws.",
      "version": "pearl"
    },
    {
      "text": "Strong electricity courses through the tips of its sharp claws. A light scratch causes fainting in foes.",
      "version": "platinum"
    },
    {
      "text": "By gathering their tails together, they collectively generate powerful electricity from their claws.",
      "version": "heartgold"
