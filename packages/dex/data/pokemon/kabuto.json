  "entries": [
    {
      "text": "A POKéMON that was resurrected from a fossil found in what was once the ocean floor eons ago.",
      "version": "red"
    },
    {
      "text": "A POKéMON that was resurrected from a fossil found in what was once the ocean floor eons ago.",
      "version": "blue"
    },
    {
      "text": "A POKéMON that was recovered from a fossil. It uses the eyes on its back while hiding on the sea floor.",
      "version": "yellow"
    },
    {
      "text": "On rare occasions, some have been found as fossils which they became while hiding on the ocean floor.",
      "version": "gold"
    },
    {
      "text": "This POKéMON lived in ancient times. On rare occasions, it has been discovered as a living fossil.",
      "version": "silver"
    },
    {
      "text": "Three hundred million years ago, it hid on the sea floor. It also has eyes on its back that glow.",
      "version": "crystal"
    },
    {
      "text": "KABUTO is a POKéMON that has been regenerated from a fossil. However, in extremely rare cases, living examples have been discovered. The POKéMON has not changed at all for 300 million years.",
