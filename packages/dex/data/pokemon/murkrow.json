{
  "category": "Darkness Pokémon",
  "entries": [
    {
      "text": "Feared and loathed by many, it is believed to bring misfortune to all those who see it at night.",
      "version": "gold"
    },
    {
      "text": "It is said that when chased, it lures its attacker onto dark mountain trails where the foe will get lost.",
      "version": "silver"
    },
    {
      "text": "It hides any shiny object it finds in a secret location. MURKROW and MEOWTH loot one another's stashes.",
      "version": "crystal"
    },
    {
      "text": "MURKROW was feared and loathed as the alleged bearer of ill fortune. This POKéMON shows strong interest in anything that sparkles or glitters. It will even try to steal rings from women.",
      "version": "ruby"
    },
    {
      "text": "MURKROW was feared and loathed as the alleged bearer of ill fortune. This POKéMON shows strong interest in anything that sparkles or glitters. It will even try to steal rings from women.",
