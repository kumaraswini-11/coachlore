{
  "category": "Fruit Pokémon",
  "entries": [
    {
      "text": "A delectable aroma pours from its body. They are often swallowed whole by Toucannon lured by that wafting deliciousness.",
      "version": "sun"
    },
    {
      "text": "Although it’s too sugary for human consumption, Bounsweet’s sweat can be watered down into a juice with just the right amount of sweetness.",
      "version": "moon"
    },
    {
      "text": "Because of its sweet, delicious aroma, bird Pokémon are always after it, but it’s not intelligent enough to care.",
      "version": "ultra-sun"
    },
    {
      "text": "It tries to resist being swallowed by a bird Pokémon by spinning the sepals on its head. It’s usually a fruitless attempt.",
      "version": "ultra-moon"
    },
    {
      "text": "Its body gives off a sweet, fruity scent that is extremely appetizing to bird Pokémon.",
      "version": "sword"
    },
    {
      "text": "When under attack, it secretes a sweet and delicious sweat. The scent only calls more enemies to it.",
      "version": "shield"
    }
  ],
