  "entries": [
    {
      "text": "Apparently this Pokémon is born when a departed spirit inhabits a sword. It attaches itself to people and drinks their life force.",
      "version": "x"
    },
    {
      "text": "If anyone dares to grab its hilt, it wraps a blue cloth around that person’s arm and drains that person’s life energy completely.",
      "version": "y"
    },
    {
      "text": "Apparently this Pokémon is born when a departed spirit inhabits a sword. It attaches itself to people and drinks their life force.",
      "version": "omega-ruby"
    },
    {
      "text": "If anyone dares to grab its hilt, it wraps a blue cloth around that person’s arm and drains that person’s life energy completely.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Honedge’s soul once belonged to a person who was killed a long time ago by the sword that makes up Honedge’s body.",
      "version": "sword"
    },
    {
      "text": "The blue eye on the sword’s handguard is the true body of Honedge. With its old cloth, it drains people’s lives away.",
      "version": "shield"
    }
