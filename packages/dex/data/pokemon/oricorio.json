{
  "category": "Dancing Pokémon",
  "entries": [
    {
      "text": "It beats its wings together to create fire. As it moves in the steps of its beautiful dance, it bathes opponents in intense flames.",
      "version": "sun"
    },
    {
      "text": "This Oricorio has sipped red nectar. Its passionate dance moves cause its enemies to combust in both body and mind.",
      "version": "moon"
    },
    {
      "text": "It wins the hearts of its enemies with its passionate dancing and then uses the opening it creates to burn them up with blazing flames.",
      "version": "ultra-sun"
    },
    {
      "text": "This Oricorio has drunk red nectar. If its Trainer gives the wrong order, this passionate Pokémon becomes fiercely angry.",
      "version": "ultra-moon"
    }
  ],
