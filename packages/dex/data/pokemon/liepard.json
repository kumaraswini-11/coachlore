  "category": "Cruel Pokémon",
  "entries": [
    {
      "text": "These Pokémon vanish and appear unexpectedly. Many Trainers are drawn to their beautiful form and fur.",
      "version": "black"
    },
    {
      "text": "Stealthily, it sneaks up on its target, striking from behind before its victim has a chance to react.",
      "version": "white"
    },
    {
      "text": "Their beautiful form comes from the muscles they have developed. They run silently in the night.",
      "version": "black-2"
    },
    {
      "text": "Their beautiful form comes from the muscles they have developed. They run silently in the night.",
      "version": "white-2"
