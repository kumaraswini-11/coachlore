    {
      "text": "Stealthily, it sneaks up on its target, striking from behind before its victim has a chance to react.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Don’t be fooled by its gorgeous fur and elegant figure. This is a moody and vicious Pokémon.",
      "version": "sword"
    },
    {
      "text": "This stealthy Pokémon sneaks up behind prey without making any sound at all. It competes with Thievul for territory.",
      "version": "shield"
    }
