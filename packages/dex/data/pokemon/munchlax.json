{
  "category": "Big Eater Pokémon",
  "entries": [
    {
      "text": "It wolfs down its weight in food once a day, swallowing food whole with almost no chewing.",
      "version": "diamond"
    },
    {
      "text": "It hides food under its long body hair. However, it forgets it has hidden the food.",
      "version": "pearl"
    },
    {
      "text": "In its desperation to gulp down food, it forgets about the food it has hidden under its fur.",
      "version": "platinum"
    },
    {
      "text": "It conceals food under the long fur on its body. It carts around this food stash and swallows it without chewing.",
      "version": "heartgold"
    },
    {
      "text": "It conceals food under the long fur on its body. It carts around this food stash and swallows it without chewing.",
      "version": "soulsilver"
    },
    {
      "text": "In its desperation to gulp down food, it forgets about the food it has hidden under its fur.",
      "version": "black"
    },
    {
