    {
      "text": "Using its dorsal fin as a suction pad, it clings to a Mantine’s underside to scavenge for leftovers.",
      "version": "y"
    },
    {
      "text": "Remoraid sucks in water, then expels it at high velocity using its abdominal muscles to shoot down flying prey. When evolution draws near, this Pokémon travels downstream from rivers.",
      "version": "omega-ruby"
    },
    {
      "text": "Remoraid sucks in water, then expels it at high velocity using its abdominal muscles to shoot down flying prey. When evolution draws near, this Pokémon travels downstream from rivers.",
      "version": "alpha-sapphire"
    },
    {
      "text": "This Pokémon clings to Mantine and shares in its prosperity. When its Mantine is attacked, Remoraid will fight alongside it!",
      "version": "ultra-sun"
    },
    {
      "text": "Also known as the “sniper of the seas,” its water gun can hit prey without fail from over 300 feet away.",
      "version": "ultra-moon"
    },
    {
      "text": "The water they shoot from their mouths can hit moving prey from more than 300 feet away.",
      "version": "sword"
    },
    {
      "text": "Using its dorsal fin as a suction pad, it clings to a Mantine’s underside to scavenge for leftovers.",
      "version": "shield"
    },
    {
      "text": "Spits water from its mouth with incredible accuracy. It captures Burmy by shooting them down off the branches from which they dangle.",
      "version": "legends-arceus"
    }
