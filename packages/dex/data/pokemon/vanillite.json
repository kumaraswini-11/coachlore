{
  "category": "Fresh Snow Pokémon",
  "entries": [
    {
      "text": "The temperature of their breath is -58° F. They create snow crystals and make snow fall in the areas around them.",
      "version": "black"
    },
    {
      "text": "This Pokémon formed from icicles bathed in energy from the morning sun. It sleeps buried in snow.",
      "version": "white"
    },
    {
      "text": "Theoretically, this Pokémon formed from icicles bathed in energy from the morning sun. Their breath is -58° F.",
      "version": "black-2"
    },
    {
      "text": "Theoretically, this Pokémon formed from icicles bathed in energy from the morning sun. Their breath is -58° F.",
      "version": "white-2"
    },
    {
      "text": "The temperature of their breath is -58 degrees Fahrenheit. They create snow crystals and make snow fall in the areas around them.",
      "version": "x"
    },
    {
      "text": "This Pokémon formed from icicles bathed in energy from the morning sun. It sleeps buried in snow.",
      "version": "y"
    },
    {
      "text": "The temperature of their breath is -58 degrees Fahrenheit. They create snow crystals and make snow fall in the areas around them.",
      "version": "omega-ruby"
    },
    {
      "text": "This Pokémon formed from icicles bathed in energy from the morning sun. It sleeps buried in snow.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Born of an icicle, this Pokémon uses its frosty breath to make ice crystals, causing snow to fall.",
      "version": "sun"
    },
    {
      "text": "It feels pleasantly cool when embraced. This Pokémon is treasured by households in warm regions.",
      "version": "moon"
    },
    {
      "text": "It exhales cold air that is at –58 degrees Fahrenheit. When it’s in a warm place, it shrinks little by little.",
      "version": "ultra-sun"
    },
    {
      "text": "When the morning sun hit an icicle, it wished not to melt, and thus Vanillite was born. At night, it buries itself in snow to sleep.",
      "version": "ultra-moon"
    },
    {
      "text": "Unable to survive in hot areas, it makes itself comfortable by breathing out air cold enough to cause snow. It burrows into the snow to sleep.",
      "version": "sword"
    },
    {
      "text": "Supposedly, this Pokémon was born from an icicle. It spews out freezing air at −58 degrees Fahrenheit to make itself more comfortable.",
      "version": "shield"
    }
  ],
