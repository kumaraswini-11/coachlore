{
  "category": "Snow Land Pokémon",
  "entries": [
    {
      "text": "It freezes foes with an icy breath nearly -60 degrees F. What seems to be its body is actually hollow.",
      "version": "diamond"
    },
    {
      "text": "It freezes foes with an icy breath nearly -60 degrees F. What seems to be its body is actually hollow.",
      "version": "pearl"
    },
    {
      "text": "It freezes prey by blowing its -58 degrees F breath. It is said to then secretly display its prey.",
      "version": "platinum"
    },
    {
      "text": "Legends in snowy regions say that a woman who was lost on an icy mountain was reborn as FROSLASS.",
      "version": "heartgold"
    },
    {
      "text": "Legends in snowy regions say that a woman who was lost on an icy mountain was reborn as FROSLASS",
      "version": "soulsilver"
