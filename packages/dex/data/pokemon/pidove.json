{
  "category": "Tiny Pigeon Pokémon",
  "entries": [
    {
      "text": "Each follows its Trainer’s orders as best it can, but they sometimes fail to understand complicated commands.",
      "version": "black"
    },
    {
      "text": "These Pokémon live in cities. They are accustomed to people. Flocks often gather in parks and plazas.",
      "version": "white"
    },
    {
      "text": "This very forgetful Pokémon will wait for a new order from its Trainer even though it already has one.",
      "version": "black-2"
