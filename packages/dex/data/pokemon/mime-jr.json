{
  "category": "Mime Pokémon",
  "entries": [
    {
      "text": "It habitually mimics foes. Once mimicked, the foe cannot take its eyes off this Pokémon.",
      "version": "diamond"
    },
    {
      "text": "It likes places where people gather. It mimics foes to confuse them, then makes its getaway.",
      "version": "pearl"
    },
    {
      "text": "It mimics the expressions and motions of those it sees to understand the feelings of others.",
      "version": "platinum"
    },
    {
      "text": "In an attempt to confuse its enemy, it mimics the enemy’s movements. Then it wastes no time in making itself scarce!",
      "version": "heartgold"
    },
    {
      "text": "In an attempt to confuse its enemy, it mimics the enemy’s movements. Then it wastes no time in making itself scarce!",
      "version": "soulsilver"
    },
    {
