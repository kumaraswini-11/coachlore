{
  "category": "Insect Pokémon",
  "entries": [
    {
      "text": "Lives in the shadows of tall trees where it eats insects. It is attracted by light at night.",
      "version": "red"
    },
    {
      "text": "Lives in the shadows of tall trees where it eats insects. It is attracted by light at night.",
      "version": "blue"
    },
    {
      "text": "Its large eyes act as radars. In a bright place, you can see that they are clusters of many tiny eyes.",
      "version": "yellow"
    },
    {
      "text": "Its eyes also function as radar units. It catches and eats small bugs that hide in darkness.",
      "version": "gold"
    },
    {
      "text": "Poison oozes from all over its body. It catches and eats small bugs at night that are attracted by light.",
      "version": "silver"
    },
    {
      "text": "The small bugs it eats appear only at night, so it sleeps in a hole in a tree until night falls.",
      "version": "crystal"
    },
    {
      "text": "VENONAT is said to have evolved with a coat of thin, stiff hair that covers its entire body for protection. It possesses large eyes that never fail to spot even miniscule prey.",
      "version": "ruby"
    },
    {
      "text": "VENONAT is said to have evolved with a coat of thin, stiff hair that covers its entire body for protection. It possesses large eyes that never fail to spot even miniscule prey.",
