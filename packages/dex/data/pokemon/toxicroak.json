{
  "category": "Toxic Mouth Pokémon",
  "entries": [
    {
      "text": "Its knuckle claws secrete a toxin so vile that even a scratch could prove fatal.",
      "version": "diamond"
    },
    {
      "text": "The toxin made in its poison sacs is pumped to the knuckle claws through tubes down its arms.",
      "version": "pearl"
    },
    {
      "text": "It has a poison sac at its throat. When it croaks, the stored poison is churned for greater potency.",
      "version": "platinum"
    },
    {
      "text": "Swaying and dodging the attacks of its foes, it weaves its flexible body in close, then lunges out with its poisonous claws.",
      "version": "heartgold"
    },
    {
      "text": "Swaying and dodging the attacks of its foes, it weaves its flexible body in close, then lunges out with its poisonous claws.",
