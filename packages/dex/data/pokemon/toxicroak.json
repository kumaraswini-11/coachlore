    {
      "text": "Its knuckle claws secrete a toxin so vile that even a scratch could prove fatal.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It bounces toward opponents and gouges them with poisonous claws. No more than a scratch is needed to knock out its adversaries.",
      "version": "sword"
    },
    {
      "text": "It booms out a victory croak when its prey goes down in defeat. This Pokémon and Seismitoad are related species.",
      "version": "shield"
    },
    {
      "text": "Its crimson claws contain a virulent toxin. This toxin can be made into a tonic by diluting it, mixing it with several types of wild grass, and boiling it down over two days.",
      "version": "legends-arceus"
    }
