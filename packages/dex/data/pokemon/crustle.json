    {
      "text": "This highly territorial Pokémon prefers dry climates. It won’t come out of its boulder on rainy days.",
      "version": "sword"
    },
    {
      "text": "Its thick claws are its greatest weapons. They’re mighty enough to crack Rhyperior’s carapace.",
      "version": "shield"
    }
