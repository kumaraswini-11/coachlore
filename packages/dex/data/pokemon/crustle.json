  "category": "Stone Home Pokémon",
  "entries": [
    {
      "text": "Competing for territory, Crustle fight viciously. The one whose boulder is broken is the loser of the battle.",
      "version": "black"
    },
    {
      "text": "It possesses legs of enormous strength, enabling it to carry heavy slabs for many days, even when crossing arid land.",
      "version": "white"
    },
    {
      "text": "When its boulder is broken in battles for territory, it feels unsure and begins to weaken.",
      "version": "black-2"
    },
