{
  "category": "Anteater Pokémon",
  "entries": [
    {
      "text": "It breathes through a hole in its tail while it burns with an internal fire. Durant is its prey.",
      "version": "black"
    },
    {
      "text": "Using their very hot, flame-covered tongues, they burn through Durant’s steel bodies and consume their insides.",
      "version": "white"
    },
    {
      "text": "It draws in air through its tail, transforms it into fire, and uses it like a tongue. It melts Durant and eats them.",
      "version": "black-2"
    },
    {
      "text": "It draws in air through its tail, transforms it into fire, and uses it like a tongue. It melts Durant and eats them.",
      "version": "white-2"
    },
    {
      "text": "Using their very hot, flame-covered tongues, they burn through Durant’s steel bodies and consume their insides.",
      "version": "x"
    },
    {
      "text": "It draws in air through its tail, transforms it into fire, and uses it like a tongue. It melts Durant and eats them.",
      "version": "y"
    },
    {
      "text": "Using their very hot, flame-covered tongues, they burn through Durant’s steel bodies and consume their insides.",
      "version": "omega-ruby"
    },
    {
      "text": "It draws in air through its tail, transforms it into fire, and uses it like a tongue. It melts Durant and eats them.",
      "version": "alpha-sapphire"
    },
    {
      "text": "There’s a hole in its tail that allows it to draw in the air it needs to keep its fire burning. If the hole gets blocked, this Pokémon will fall ill.",
      "version": "sword"
    },
    {
      "text": "A flame serves as its tongue, melting through the hard shell of Durant so that Heatmor can devour their insides.",
      "version": "shield"
    }
  ],
