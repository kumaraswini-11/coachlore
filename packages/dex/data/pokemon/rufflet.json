  "entries": [
    {
      "text": "They crush berries with their talons. They bravely stand up to any opponent, no matter how strong it is.",
      "version": "black"
    },
    {
      "text": "They will challenge anything, even strong opponents, without fear. Their frequent fights help them become stronger.",
      "version": "white"
    },
    {
      "text": "It stands up to massive opponents, not out of courage, but out of recklessness. But that is how it gets stronger.",
      "version": "black-2"
    },
