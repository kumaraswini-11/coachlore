{
  "category": "Human Shape Pokémon",
  "entries": [
    {
      "text": "It seductively wiggles its hips as it walks. It can cause people to dance in unison with it.",
      "version": "red"
    },
    {
      "text": "It seductively wiggles its hips as it walks. It can cause people to dance in unison with it.",
      "version": "blue"
    },
    {
      "text": "Appears to move to a rhythm of its own, as if it were dancing. It wiggles its hips as it walks.",
      "version": "yellow"
    },
    {
      "text": "It rocks its body rhythmically. It appears to alter the rhythm depending on how it is feeling.",
      "version": "gold"
    },
    {
      "text": "It speaks a language similar to that of humans. However, it seems to use dancing to communicate.",
      "version": "silver"
    },
    {
      "text": "It has several different cry patterns, each of which seems to have its own meaning.",
      "version": "crystal"
    },
    {
      "text": "JYNX walks rhythmically, swaying and shaking its hips as if it were dancing. Its motions are so bouncingly alluring, people seeing it are compelled to shake their hips without giving any thought to what they are doing.",
      "version": "ruby"
    },
    {
      "text": "JYNX walks rhythmically, swaying and shaking its hips as if it were dancing. Its motions are so bouncingly alluring, people seeing it are compelled to shake their hips without giving any thought to what they are doing.",
      "version": "sapphire"
    },
    {
      "text": "A JYNX sashays rhythmically as if it were dancing. Its motions are so bouncingly alluring, people seeing it are compelled to shake their hips without noticing.",
      "version": "emerald"
    },
    {
      "text": "It speaks using a language that sounds human. Research is under way to determine what is being said.",
      "version": "firered"
    },
    {
      "text": "It seductively wiggles its hips as it walks. It can cause people to dance in unison with it.",
      "version": "leafgreen"
    },
    {
      "text": "Its cries sound like human speech. However, it is impossible to tell what it is trying to say.",
      "version": "diamond"
