  "entries": [
    {
      "text": "It nests in small, horizontal holes in cave walls. It pounces to catch prey that stray too close.",
      "version": "diamond"
    },
    {
      "text": "It once lived in the tropics. To avoid the cold, it lives in caves warmed by geothermal heat.",
      "version": "pearl"
    },
    {
      "text": "It attacks using its huge mouth. While its attacks are powerful, it hurts itself out of clumsiness, too.",
      "version": "platinum"
    },
    {
      "text": "It nests in horizontal holes warmed by geothermal heat. Foes who get too close can expect to be pounced on and bitten.",
