{
  "category": "Muscular Pokémon",
  "entries": [
    {
      "text": "It is thought that Conkeldurr taught humans how to make concrete more than 2,000 years ago.",
      "version": "black"
    },
    {
      "text": "They use concrete pillars as walking canes. They know moves that enable them to swing the pillars freely in battle.",
      "version": "white"
    },
    {
      "text": "Rather than rely on force, they master moves that utilize the centrifugal force of spinning concrete.",
      "version": "black-2"
    },
    {
      "text": "Rather than rely on force, they master moves that utilize the centrifugal force of spinning concrete.",
      "version": "white-2"
    },
    {
