  "category": "Beaver Pokémon",
  "entries": [
    {
      "text": "It makes its nest by damming streams with bark and mud. It is known as an industrious worker.",
      "version": "diamond"
    },
    {
      "text": "While its movements out of water are sluggish, it can swim as fast as any FEEBAS.",
      "version": "pearl"
    },
    {
      "text": "A river dammed by BIBAREL will never overflow its banks, which is appreciated by people nearby.",
      "version": "platinum"
    },
    {
      "text": "It busily makes its nest with stacks of branches and roots it has cut up with its sharp incisors.",
      "version": "heartgold"
    },
