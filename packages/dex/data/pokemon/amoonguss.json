{
  "category": "Mushroom Pokémon",
  "entries": [
    {
      "text": "It lures prey close by dancing and waving its arm caps, which resemble Poké Balls, in a swaying motion.",
      "version": "black"
    },
    {
      "text": "They show off their Poké Ball caps to lure prey, but very few Pokémon are fooled by this.",
      "version": "white"
    },
    {
      "text": "It moves the caps on both arms and does a dance to lure prey. It prefers damp places.",
      "version": "black-2"
    },
    {
      "text": "It moves the caps on both arms and does a dance to lure prey. It prefers damp places.",
      "version": "white-2"
    },
    {
      "text": "They show off their Poké Ball caps to lure prey, but very few Pokémon are fooled by this.",
      "version": "x"
    },
    {
      "text": "It lures prey close by dancing and waving its arm caps, which resemble Poké Balls, in a swaying motion.",
      "version": "y"
    },
    {
      "text": "They show off their Poké Ball caps to lure prey, but very few Pokémon are fooled by this.",
      "version": "omega-ruby"
    },
    {
      "text": "It lures prey close by dancing and waving its arm caps, which resemble Poké Balls, in a swaying motion.",
      "version": "alpha-sapphire"
    },
    {
      "text": "This Pokémon puffs poisonous spores at its foes. If the spores aren’t washed off quickly, they’ll grow into mushrooms wherever they land.",
      "version": "sword"
    },
    {
      "text": "Amoonguss generally doesn’t move much. It tends to stand still near Poké Balls that have been dropped on the ground.",
      "version": "shield"
    }
  ],
