  "entries": [
    {
      "text": "When its body temperature goes up, it turns into steam and vanishes. When its temperature lowers, it returns to ice.",
      "version": "black"
    },
    {
      "text": "They are born in snow clouds. They use chains made of ice crystals to capture prey.",
      "version": "white"
    },
    {
      "text": "They are composed of ice crystals. They capture prey with chains of ice, freezing the prey at -148° F.",
      "version": "black-2"
    },
    {
      "text": "They are composed of ice crystals. They capture prey with chains of ice, freezing the prey at -148° F.",
      "version": "white-2"
    },
    {
      "text": "They are born in snow clouds. They use chains made of ice crystals to capture prey.",
      "version": "x"
    },
    {
      "text": "They are composed of ice crystals. They capture prey with chains of ice, freezing the prey at -148 degrees Fahrenheit.",
      "version": "y"
