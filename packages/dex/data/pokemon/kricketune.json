  "entries": [
    {
      "text": "It crosses its knifelike arms in front of its chest when it cries. It can compose melodies ad lib.",
      "version": "diamond"
    },
    {
      "text": "It signals its emotions with its melodies. Scientists are studying these melodic patterns.",
      "version": "pearl"
    },
    {
      "text": "There is a village that hosts a contest based on the amazingly variable cries of this Pokémon.",
      "version": "platinum"
    },
    {
      "text": "By allowing its cry to resonate in the hollow of its belly, it produces a captivating sound.",
