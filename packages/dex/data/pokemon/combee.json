{
  "category": "Tiny Bee Pokémon",
  "entries": [
    {
      "text": "A Pokémon formed by three others. It busily carries sweet floral honey to VESPIQUEN.",
      "version": "diamond"
    },
    {
      "text": "It collects and delivers honey to its colony. At night, they cluster to form a beehive and sleep.",
      "version": "pearl"
    },
    {
      "text": "The trio is together from birth. It constantly gathers honey from flowers to please VESPIQUEN.",
      "version": "platinum"
    },
    {
      "text": "At night, COMBEE sleep in a group of about a thousand, packed closely together in a lump.",
      "version": "heartgold"
    },
    {
      "text": "At night, COMBEE sleep in a group of about a thousand, packed closely together in a lump.",
      "version": "soulsilver"
    },
    {
      "text": "The trio is together from birth. It constantly gathers honey from flowers to please Vespiquen.",
      "version": "black"
    },
    {
      "text": "The trio is together from birth. It constantly gathers honey from flowers to please Vespiquen.",
      "version": "white"
    },
    {
      "text": "This Pokémon is a set of three. When they sleep, they gather up and form a giant hive of 100 Combee.",
      "version": "black-2"
    },
    {
      "text": "This Pokémon is a set of three. When they sleep, they gather up and form a giant hive of 100 Combee.",
      "version": "white-2"
    },
    {
      "text": "The trio is together from birth. It constantly gathers honey from flowers to please Vespiquen.",
      "version": "x"
    },
    {
      "text": "It collects and delivers honey to its colony. At night, they cluster to form a beehive and sleep.",
      "version": "y"
    },
    {
      "text": "The trio is together from birth. It constantly gathers honey from flowers to please Vespiquen.",
      "version": "omega-ruby"
    },
    {
      "text": "It collects and delivers honey to its colony. At night, they cluster to form a beehive and sleep.",
      "version": "alpha-sapphire"
    },
    {
      "text": "The members of the trio spend all their time together. Each one has a slightly different taste in nectar.",
      "version": "sword"
    },
    {
      "text": "It ceaselessly gathers nectar from sunrise to sundown, all for the sake of Vespiquen and the swarm.",
      "version": "shield"
    },
    {
      "text": "They swear fealty to a queen Pokémon and work diligently to gather nectar. Each swarm produces a different flavor of honey.",
      "version": "legends-arceus"
    }
  ],
