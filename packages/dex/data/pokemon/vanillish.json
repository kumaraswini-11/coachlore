{
  "category": "Icy Snow Pokémon",
  "entries": [
    {
      "text": "Snowy mountains are this Pokémon’s habitat. During an ancient ice age, they moved to southern areas.",
      "version": "black"
    },
    {
      "text": "It conceals itself from enemy eyes by creating many small ice particles and hiding among them.",
      "version": "white"
    },
    {
      "text": "They cool down the surrounding air and create ice particles, which they use to freeze their foes.",
      "version": "black-2"
    },
    {
      "text": "They cool down the surrounding air and create ice particles, which they use to freeze their foes.",
      "version": "white-2"
    },
    {
      "text": "They cool down the surrounding air and create ice particles, which they use to freeze their foes.",
      "version": "x"
    },
    {
      "text": "Snowy mountains are this Pokémon’s habitat. During an ancient ice age, they moved to southern areas.",
      "version": "y"
    },
    {
      "text": "They cool down the surrounding air and create ice particles, which they use to freeze their foes.",
      "version": "omega-ruby"
    },
    {
      "text": "Snowy mountains are this Pokémon’s habitat. During an ancient ice age, they moved to southern areas.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Hot days cause its body to melt. It can be restored by refreezing it, but the process leaves its body slightly warped.",
      "version": "sun"
    },
    {
      "text": "This Pokémon has existed since the Ice Age. It controls particles of ice, freezes its opponents, and then shatters them with a headbutt.",
      "version": "moon"
    },
    {
      "text": "It sprays its enemies with grains of ice to freeze them. Most Vanillish in Alola are smaller than average.",
      "version": "ultra-sun"
    },
    {
      "text": "This hearty Pokémon survived the Ice Age. It’s incredibly popular in very hot regions.",
      "version": "ultra-moon"
    },
    {
      "text": "By drinking pure water, it grows its icy body. This Pokémon can be hard to find on days with warm, sunny weather.",
      "version": "sword"
    },
    {
      "text": "It blasts enemies with cold air reaching −148 degrees Fahrenheit, freezing them solid. But it spares their lives afterward—it’s a kind Pokémon.",
      "version": "shield"
    }
  ],
