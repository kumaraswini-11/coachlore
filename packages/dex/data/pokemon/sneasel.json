{
  "category": "Sharp Claw Pokémon",
  "entries": [
    {
      "text": "Its paws conceal sharp claws. If attacked, it sud denly extends the claws and startles its enemy.",
      "version": "gold"
    },
    {
      "text": "Vicious in nature, it drives PIDGEY from their nests and feasts on the eggs that are left behind.",
      "version": "silver"
    },
    {
      "text": "This cunning POKéMON hides under the cover of darkness, waiting to attack its prey.",
      "version": "crystal"
    },
    {
      "text": "SNEASEL scales trees by punching its hooked claws into the bark. This POKéMON seeks out unguarded nests and steals eggs for food while the parents are away.",
      "version": "ruby"
    },
    {
      "text": "SNEASEL scales trees by punching its hooked claws into the bark. This POKéMON seeks out unguarded nests and steals eggs for food while the parents are away.",
      "version": "sapphire"
    },
    {
      "text": "A SNEASEL scales trees by punching its hooked claws into the bark. It seeks out unguarded nests and steals eggs for food while the parents are away.",
      "version": "emerald"
    },
    {
      "text": "Vicious in nature, it drives PIDGEY from their nests and feasts on the eggs that are left behind.",
      "version": "firered"
    },
    {
      "text": "Its paws conceal sharp claws. If attacked, it suddenly extends the claws and startles its enemy.",
      "version": "leafgreen"
    },
    {
      "text": "It feeds on eggs stolen from nests. Its sharply hooked claws rip vulnerable spots on prey.",
      "version": "diamond"
    },
    {
      "text": "It is extremely vicious and will not stop attacking until its foe is incapable of moving.",
      "version": "pearl"
    },
    {
      "text": "A smart and sneaky Pokémon. A pair may work together to steal eggs by having one lure the parents away.",
      "version": "platinum"
    },
    {
      "text": "Its paws conceal sharp claws. If attacked, it suddenly extends the claws and startles its enemy.",
      "version": "heartgold"
    },
    {
      "text": "Vicious in nature, it drives PIDGEY from their nests and scavenges any leftovers it can find.",
      "version": "soulsilver"
    },
    {
      "text": "A smart and sneaky Pokémon. A pair may work together to steal eggs by having one lure the parents away.",
      "version": "black"
    },
    {
      "text": "A smart and sneaky Pokémon. A pair may work together to steal eggs by having one lure the parents away.",
      "version": "white"
    },
    {
      "text": "A smart and sneaky Pokémon, it makes its opponents flinch by suddenly showing the claws hidden in its paws.",
      "version": "black-2"
    },
    {
      "text": "A smart and sneaky Pokémon, it makes its opponents flinch by suddenly showing the claws hidden in its paws.",
      "version": "white-2"
    },
    {
      "text": "It feeds on eggs stolen from nests. Its sharply hooked claws rip vulnerable spots on prey.",
      "version": "x"
    },
    {
      "text": "Its paws conceal sharp claws. If attacked, it suddenly extends the claws and startles its enemy.",
      "version": "y"
    },
    {
      "text": "Sneasel scales trees by punching its hooked claws into the bark. This Pokémon seeks out unguarded nests and steals eggs for food while the parents are away.",
      "version": "omega-ruby"
    },
    {
      "text": "Sneasel scales trees by punching its hooked claws into the bark. This Pokémon seeks out unguarded nests and steals eggs for food while the parents are away.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It has a cunning yet savage disposition. It waits for parents to leave their nests, and then it sneaks in to steal their eggs.",
      "version": "sun"
    },
    {
      "text": "It uses its claws to poke holes in eggs so it can slurp out the insides. Breeders consider it a scourge and will drive it away or eradicate it.",
      "version": "moon"
    },
    {
      "text": "They will cooperate to steal eggs from the nests of bird Pokémon, but fights break out to determine which one gets to eat the eggs.",
      "version": "ultra-sun"
    },
    {
      "text": "It blends into the dark of night to ambush its prey. Sneasel will attack Sandshrew, but its hard skin can cause Sneasel’s claws to snap off.",
      "version": "ultra-moon"
    },
    {
      "text": "Its paws conceal sharp claws. If attacked, it suddenly extends the claws and startles its enemy.",
      "version": "sword"
    },
    {
      "text": "It has a cunning yet savage disposition. It waits for parents to leave their nests, and then it sneaks in to steal their eggs.",
      "version": "shield"
    },
    {
      "text": "Its sturdy, curved claws are ideal for traversing precipitous cliffs. From the tips of these claws drips a venom that infiltrates the nerves of any prey caught in Sneasel's grasp.",
      "version": "legends-arceus"
    }
  ],
