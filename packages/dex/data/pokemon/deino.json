  "category": "Irate Pokémon",
  "entries": [
    {
      "text": "It tends to bite everything, and it is not a picky eater. Approaching it carelessly is dangerous.",
      "version": "black"
    },
    {
      "text": "They cannot see, so they tackle and bite to learn about their surroundings. Their bodies are covered in wounds.",
      "version": "white"
    },
    {
      "text": "Lacking sight, it’s unaware of its surroundings, so it bumps into things and eats anything that moves.",
      "version": "black-2"
    },
