  "entries": [
    {
      "text": "All of its fur dazzles if danger is sensed. It flees while the foe is momentarily blinded.",
      "version": "diamond"
    },
    {
      "text": "Its forelegs have a muscle-based system of generating electricity. Its body shines if endangered.",
      "version": "pearl"
    },
    {
      "text": "The extension and contraction of its muscles generates electricity. It glows when in trouble.",
