    {
      "text": "All of its fur dazzles if danger is sensed. It flees while the foe is momentarily blinded.",
      "version": "alpha-sapphire"
    },
    {
      "text": "This Pokémon generates electricity by contracting its muscles. Excited trembling is a sign that Shinx is generating a tremendous amount of electricity.",
      "version": "sword"
    },
    {
      "text": "Electricity makes this Pokémon’s fur glow. Shinx sends signals to others of its kind by shaking the tip of its tail while the tail tip is shining brightly.",
      "version": "shield"
    },
    {
      "text": "Shakes its body to generate electricity. Its stature belies its aggression—one must be patient to tame this Pokémon.",
      "version": "legends-arceus"
    }
  ],
