  "category": "Fruit Pokémon",
  "entries": [
    {
      "text": "The bunches of fruit around TROPIUS’s neck are very popular with children. This POKéMON loves fruit, and eats it continuously. Apparently, its love for fruit resulted in its own outgrowth of fruit.",
      "version": "ruby"
    },
    {
      "text": "Children of the southern tropics eat as snacks the fruit that grows in bunches around the neck of TROPIUS. This POKéMON flies by flapping the leaves on its back as if they were wings.",
      "version": "sapphire"
    },
    {
      "text": "It flies by flapping its broad leaves. The bunch of fruit that grows around its neck is deliciously sweet. In the spring, it scatters pollen from its neck.",
      "version": "emerald"
    },
    {
      "text": "It lives in tropical jungles. The bunch of fruit around its neck is delicious. The fruit grows twice a year.",
      "version": "firered"
    },
    {
      "text": "It lives in tropical jungles. The bunch of fruit around its neck is delicious. The fruit grows twice a year.",
      "version": "leafgreen"
    },
    {
      "text": "Because it continually ate only its favorite fruit, the fruit started growing around its neck.",
      "version": "diamond"
    },
    {
      "text": "Because it continually ate only its favorite fruit, the fruit started growing around its neck.",
      "version": "pearl"
