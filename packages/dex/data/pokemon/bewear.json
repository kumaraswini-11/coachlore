{
  "category": "Strong Arm Pokémon",
  "entries": [
    {
      "text": "This immensely dangerous Pokémon possesses overwhelming physical strength. Its habitat is generally off-limits.",
      "version": "sun"
    },
    {
      "text": "This Pokémon has the habit of hugging its companions. Many Trainers have left this world after their spines were squashed by its hug.",
      "version": "moon"
    },
    {
      "text": "It waves its hands wildly in intimidation and warning. Life is over for anyone who doesn’t run away as fast as possible.",
      "version": "ultra-sun"
    },
    {
      "text": "It boasts tremendous physical strength. Many people call it the most dangerous Pokémon in the Alola region.",
      "version": "ultra-moon"
    },
    {
      "text": "Once it accepts you as a friend, it tries to show its affection with a hug. Letting it do that is dangerous—it could easily shatter your bones.",
      "version": "sword"
    },
    {
      "text": "The moves it uses to take down its prey would make a martial artist jealous. It tucks subdued prey under its arms to carry them to its nest.",
      "version": "shield"
    }
  ],
