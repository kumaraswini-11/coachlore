{
  "category": "Snowstorm Pokémon",
  "entries": [
    {
      "text": "Swallowing large amounts of water, they make snow clouds inside their bodies and attack their foes with violent blizzards.",
      "version": "black"
    },
    {
      "text": "If both heads get angry simultaneously, this Pokémon expels a blizzard, burying everything in snow.",
      "version": "white"
    },
    {
      "text": "Swallowing large amounts of water, they make snow clouds inside their bodies and, when angry, cause violent blizzards.",
      "version": "black-2"
    },
    {
      "text": "Swallowing large amounts of water, they make snow clouds inside their bodies and, when angry, cause violent blizzards.",
      "version": "white-2"
    },
    {
      "text": "If both heads get angry simultaneously, this Pokémon expels a blizzard, burying everything in snow.",
      "version": "x"
    },
    {
      "text": "Swallowing large amounts of water, they make snow clouds inside their bodies and, when angry, cause violent blizzards.",
      "version": "y"
    },
    {
      "text": "If both heads get angry simultaneously, this Pokémon expels a blizzard, burying everything in snow.",
      "version": "omega-ruby"
    },
    {
      "text": "Swallowing large amounts of water, they make snow clouds inside their bodies and, when angry, cause violent blizzards.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Each of its two heads has a brain, and when they are in agreement, it attacks its enemies by exhaling a violent blizzard.",
      "version": "sun"
    },
    {
      "text": "Even if it loses one of its heads, it can live relatively problem-free. It makes snow clouds inside its body.",
      "version": "moon"
    },
    {
      "text": "It blasts blizzards from its two mouths. It can create snow anywhere, so it gets a lot of love from skiers and snowboarders.",
      "version": "ultra-sun"
    },
    {
      "text": "Vanilluxe is born when two Vanillish, half-melted by the day’s light, stick to each other and freeze together in the cold return of night.",
      "version": "ultra-moon"
    },
    {
      "text": "When its anger reaches a breaking point, this Pokémon unleashes a fierce blizzard that freezes every creature around it, be they friend or foe.",
      "version": "sword"
    },
    {
      "text": "People believe this Pokémon formed when two Vanillish stuck together. Its body temperature is roughly 21 degrees Fahrenheit.",
      "version": "shield"
    }
  ],
