{
  "category": "Scorpion Pokémon",
  "entries": [
    {
      "text": "It grips prey with its tail claws and injects poison. It tenaciously hangs on until the poison takes.",
      "version": "diamond"
    },
    {
      "text": "It lives in arid lands. It buries itself in sand and lies in wait for unsuspecting prey.",
      "version": "pearl"
    },
    {
      "text": "As soon as the tail claws close, its needle tips secrete poison. It can survive a year without food.",
      "version": "platinum"
    },
    {
      "text": "It burrows under the sand to lie in wait for prey. Its tail claws can inject its prey with a savage poison.",
      "version": "heartgold"
    },
