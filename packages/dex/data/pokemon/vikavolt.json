{
  "category": "Stag Beetle Pokémon",
  "entries": [
    {
      "text": "It zips around, on sharp lookout for an opening. It concentrates electrical energy within its large jaws and uses it to zap its enemies.",
      "version": "sun"
    },
    {
      "text": "It produces electricity via an electrical organ in its abdomen. It overwhelms bird Pokémon with shocking beams of electrical energy.",
      "version": "moon"
    },
    {
      "text": "It has an organ that generates electricity in its abdomen. It concentrates energy in its strong jaws and fires off powerful jolts of electricity.",
      "version": "ultra-sun"
    },
    {
      "text": "Vikavolt flusters opponents with acrobatic flying maneuvers. This creates an opening for it to deliver an electric beam attack.",
      "version": "ultra-moon"
    },
    {
      "text": "It builds up electricity in its abdomen, focuses it through its jaws, and then fires the electricity off in concentrated beams.",
      "version": "sword"
    },
    {
      "text": "If it carries a Charjabug to use as a spare battery, a flying Vikavolt can rapidly fire high-powered beams of electricity.",
      "version": "shield"
    }
  ],
