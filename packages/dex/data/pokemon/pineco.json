{
  "category": "Bagworm Pokémon",
  "entries": [
    {
      "text": "It likes to make its shell thicker by adding layers of tree bark. The additional weight doesn't bother it.",
      "version": "gold"
    },
    {
      "text": "It hangs and waits for flying insect prey to come near. It does not move about much on its own.",
      "version": "silver"
    },
    {
      "text": "It spits out a fluid that it uses to glue tree bark to its body. The fluid hardens when it touches air.",
      "version": "crystal"
    },
    {
      "text": "PINECO hangs from a tree branch and patiently waits for prey to come along. If the POKéMON is disturbed while eating by someone shaking its tree, it drops down to the ground and explodes with no warning.",
      "version": "ruby"
    },
    {
      "text": "PINECO hangs from a tree branch and patiently waits for prey to come along. If the POKéMON is disturbed while eating by someone shaking its tree, it drops down to the ground and explodes with no warning.",
      "version": "sapphire"
    },
    {
      "text": "A PINECO hangs from a tree branch and waits for prey. While eating, if it is disturbed by someone shaking its tree, it falls on the ground and suddenly explodes.",
      "version": "emerald"
    },
    {
      "text": "It hangs and waits for flying-insect prey to come near. It does not move about much on its own.",
      "version": "firered"
    },
    {
      "text": "It likes to make its shell thicker by adding layers of tree bark. The extra weight doesn’t bother it.",
      "version": "leafgreen"
    },
    {
      "text": "It looks just like a pinecone. Its shell protects it from bird Pokémon that peck it by mistake.",
      "version": "diamond"
