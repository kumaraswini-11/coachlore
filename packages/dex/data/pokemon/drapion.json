      "version": "black"
    },
    {
      "text": "Possessing a sturdy build, it takes pride in its strength, taking down foes without using toxins.",
      "version": "white"
    },
    {
      "text": "It takes pride in its strength. Even though it can tear foes apart, it finishes them off with powerful poison.",
      "version": "black-2"
