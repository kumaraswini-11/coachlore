{
  "category": "Ogre Scorpion Pokémon",
  "entries": [
    {
      "text": "It has the power in its clawed arms to make scrap of a car. The tips of its claws release poison.",
      "version": "diamond"
    },
    {
      "text": "Its body is encased in a sturdy shell. Its head rotates 180 degrees, eliminating blind spots.",
      "version": "pearl"
    },
    {
      "text": "Possessing a sturdy build, it takes pride in its strength, taking down foes without using toxins.",
      "version": "platinum"
    },
    {
      "text": "It attacks people and Pokémon that cross the desert. This has only furthered its bad reputation.",
      "version": "heartgold"
    },
    {
      "text": "It attacks people and Pokémon that cross the desert. This has only furthered its bad reputation.",
      "version": "soulsilver"
    },
    {
