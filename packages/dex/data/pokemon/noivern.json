  "category": "Sound Wave Pokémon",
  "entries": [
    {
      "text": "They fly around on moonless nights and attack careless prey. Nothing can beat them in a battle in the dark.",
      "version": "x"
    },
    {
      "text": "The ultrasonic waves it emits from its ears can reduce a large boulder to pebbles. It swoops out of the dark to attack.",
      "version": "y"
    },
    {
      "text": "They fly around on moonless nights and attack careless prey. Nothing can beat them in a battle in the dark.",
      "version": "omega-ruby"
    },
    {
      "text": "The ultrasonic waves it emits from its ears can reduce a large boulder to pebbles. It swoops out of the dark to attack.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Although it has a violent disposition, if you give it a nice ripe fruit that it loves, Noivern will suddenly become tame.",
      "version": "ultra-sun"
    },
    {
      "text": "This hot-blooded Pokémon attacks anything it sees with ultrasonic waves that can crush boulders.",
      "version": "ultra-moon"
    },
    {
      "text": "Aggressive and cruel, this Pokémon will ruthlessly torment enemies that are helpless in the dark.",
      "version": "sword"
    },
    {
      "text": "Flying through the darkness, it weakens enemies with ultrasonic waves that could crush stone. Its fangs finish the fight.",
      "version": "shield"
    }
