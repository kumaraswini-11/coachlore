    {
      "text": "Ponyta is very weak at birth. It can barely stand up. This Pokémon becomes stronger by stumbling and falling to keep up with its parent.",
      "version": "omega-ruby"
    },
    {
      "text": "Ponyta is very weak at birth. It can barely stand up. This Pokémon becomes stronger by stumbling and falling to keep up with its parent.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Capable of jumping incredibly high. Its hooves and sturdy legs absorb the impact of a hard landing.",
      "version": "lets-go-pikachu"
    },
    {
      "text": "Capable of jumping incredibly high. Its hooves and sturdy legs absorb the impact of a hard landing.",
      "version": "lets-go-eevee"
    },
    {
      "text": "It can’t run properly when it’s newly born. As it races around with others of its kind, its legs grow stronger.",
      "version": "sword"
    },
    {
      "text": "If you’ve been accepted by Ponyta, its burning mane is mysteriously no longer hot to the touch.",
      "version": "shield"
    },
    {
      "text": "These Pokémon live in herds out in the grassland. Newborn foals lack their fiery manes, which will develop about an hour after birth.",
      "version": "legends-arceus"
    }
