{
  "category": "Scaly Pokémon",
  "entries": [
    {
      "text": "It leaps at its prey with a courageous shout. Its scaly punches tear its opponents to shreds.",
      "version": "sun"
    },
    {
      "text": "It sheds and regrows its scales on a continuous basis. The scales become harder and sharper each time they’re regrown.",
      "version": "moon"
    },
    {
      "text": "It makes noise by clanging its scales together. When the rhythm has reached its peak, Hakamo-o attacks.",
      "version": "ultra-sun"
    },
    {
      "text": "The scales it sheds can be molded and processed to make pots and pans. They conduct heat well, so they’re a popular item.",
      "version": "ultra-moon"
    },
    {
      "text": "The scaleless, scarred parts of its body are signs of its strength. It shows them off to defeated opponents.",
      "version": "sword"
    },
    {
      "text": "Before attacking its enemies, it clashes its scales together and roars. Its sharp claws shred the opposition.",
      "version": "shield"
    }
  ],
