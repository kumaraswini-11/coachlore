{
  "category": "Order Pokémon",
  "entries": [
    {
      "text": "When the Kalos region’s ecosystem falls into disarray, it appears and reveals its secret power.",
      "version": "x"
    },
    {
      "text": "It’s hypothesized that it’s monitoring those who destroy the ecosystem from deep in the cave where it lives.",
      "version": "y"
    },
    {
      "text": "When the Kalos region’s ecosystem falls into disarray, it appears and reveals its secret power.",
      "version": "omega-ruby"
    },
    {
      "text": "It’s hypothesized that it’s monitoring those who destroy the ecosystem from deep in the cave where it lives.",
      "version": "alpha-sapphire"
    },
    {
      "text": "This is Zygarde’s form when it has gathered 50% of its cells. It wipes out all those who oppose it, showing not a shred of mercy.",
      "version": "sun"
    },
    {
      "text": "It’s thought to be monitoring the ecosystem. There are rumors that even greater power lies hidden within it.",
      "version": "moon"
    },
    {
      "text": "This is Zygarde’s form when about half of its pieces have been assembled. It plays the role of monitoring the ecosystem.",
      "version": "ultra-sun"
    },
    {
      "text": "Some say it can change to an even more powerful form when battling those who threaten the ecosystem.",
      "version": "ultra-moon"
    }
  ],
