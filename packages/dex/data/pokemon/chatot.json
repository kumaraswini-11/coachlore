  "category": "Music Note Pokémon",
  "entries": [
    {
      "text": "It can learn and speak human words. If they gather, they all learn the same saying.",
      "version": "diamond"
    },
    {
      "text": "It keeps rhythm by flicking its tail feathers like a metronome. It imitates human speech.",
      "version": "pearl"
    },
    {
      "text": "Its tongue is just like a human’s. As a result, it can cleverly mimic human speech.",
      "version": "platinum"
    },
    {
      "text": "It mimics the cries of other Pokémon to trick them into thinking it’s one of them. This way they won’t attack it.",
      "version": "heartgold"
    },
