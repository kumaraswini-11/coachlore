{
  "category": "Karate Pokémon",
  "entries": [
    {
      "text": "The sound of Sawk punching boulders and trees can be heard all the way from the mountains where they train.",
      "version": "black"
    },
    {
      "text": "Tying their belts gets them pumped and makes their punches more destructive. Disturbing their training angers them.",
      "version": "white"
    },
    {
      "text": "Desiring the strongest karate chop, they seclude themselves in mountains and train without sleeping.",
      "version": "black-2"
    },
    {
      "text": "Desiring the strongest karate chop, they seclude themselves in mountains and train without sleeping.",
      "version": "white-2"
    },
    {
      "text": "Desiring the strongest karate chop, they seclude themselves in mountains and train without sleeping.",
      "version": "x"
    },
    {
      "text": "Tying their belts gets them pumped and makes their punches more destructive. Disturbing their training angers them.",
      "version": "y"
    },
    {
      "text": "Desiring the strongest karate chop, they seclude themselves in mountains and train without sleeping.",
      "version": "omega-ruby"
    },
    {
      "text": "Tying their belts gets them pumped and makes their punches more destructive. Disturbing their training angers them.",
      "version": "alpha-sapphire"
    },
    {
      "text": "If you see a Sawk training in the mountains in its single-minded pursuit of strength, it’s best to quietly pass by.",
      "version": "sword"
    },
    {
      "text": "The karate chops of a Sawk that’s trained itself to the limit can cleave the ocean itself.",
      "version": "shield"
    }
