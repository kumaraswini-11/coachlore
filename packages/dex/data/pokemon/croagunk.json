    {
      "text": "Inflating its poison sacs, it fills the area with an odd sound and hits flinching opponents with a poison jab.",
      "version": "alpha-sapphire"
    },
    {
      "text": "It makes frightening noises with its poison-filled cheek sacs. When opponents flinch, Croagunk hits them with a poison jab.",
      "version": "sword"
    },
    {
      "text": "Once diluted, its poison becomes medicinal. This Pokémon came into popularity after a pharmaceutical company chose it as a mascot.",
      "version": "shield"
    },
    {
      "text": "A poison wielder with a dastardly personality. Despite such qualities, this species is afforded a measure of popularity due to its peculiar cry and comical features.",
      "version": "legends-arceus"
    }
