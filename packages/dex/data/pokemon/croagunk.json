{
  "category": "Toxic Mouth Pokémon",
  "entries": [
    {
      "text": "Its cheeks hold poison sacs. It tries to catch foes off guard to jab them with toxic fingers.",
      "version": "diamond"
    },
    {
      "text": "Inflating its poison sacs, it makes an eerie blubbering sound for intimidation.",
      "version": "pearl"
    },
    {
      "text": "It rarely fights fairly, but that is strictly to ensure survival. It is popular as a mascot.",
      "version": "platinum"
    },
    {
      "text": "Fluid squeezed from its finger, albeit poisonous, is a significant ingredient in remedies for lower-back pain.",
      "version": "heartgold"
    },
    {
      "text": "Fluid squeezed from its finger, albeit poisonous, is a significant ingredient in remedies for lower back pain.",
      "version": "soulsilver"
    },
