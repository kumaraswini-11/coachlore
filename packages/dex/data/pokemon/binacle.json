{
  "category": "Two-Handed Pokémon",
  "entries": [
    {
      "text": "Two Binacle live together on one rock. When they fight, one of them will move to a different rock.",
      "version": "x"
    },
    {
      "text": "They stretch and then contract, yanking their rocks along with them in bold hops. They eat seaweed that washes up on the shoreline.",
      "version": "y"
    },
    {
      "text": "Two Binacle live together on one rock. When they fight, one of them will move to a different rock.",
      "version": "omega-ruby"
    },
    {
      "text": "They stretch and then contract, yanking their rocks along with them in bold hops. They eat seaweed that washes up on the shoreline.",
      "version": "alpha-sapphire"
    },
    {
      "text": "After two Binacle find a suitably sized rock, they adhere themselves to it and live together. They cooperate to gather food during high tide.",
      "version": "sword"
    },
    {
      "text": "If the two don’t work well together, both their offense and defense fall apart. Without good teamwork, they won’t survive.",
      "version": "shield"
    }
  ],
