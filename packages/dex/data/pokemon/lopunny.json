{
  "category": "Rabbit Pokémon",
  "entries": [
    {
      "text": "An extremely cautious Pokémon. It cloaks its body with its fluffy ear fur when it senses danger.",
      "version": "diamond"
    },
    {
      "text": "It is very conscious of its looks and never fails to groom its ears. It runs with sprightly jumps.",
      "version": "pearl"
    },
    {
      "text": "The ears appear to be delicate. If they are touched roughly, it kicks with its graceful legs.",
      "version": "platinum"
    },
    {
      "text": "It sheds its fur twice a year. Its winter fur is soft and fluffy.",
      "version": "heartgold"
    },
    {
      "text": "It sheds its fur twice a year. Its winter fur is soft and fluffy.",
      "version": "soulsilver"
    },
    {
      "text": "The ears appear to be delicate. If they are touched roughly, it kicks with its graceful legs.",
      "version": "black"
    },
    {
      "text": "The ears appear to be delicate. If they are touched roughly, it kicks with its graceful legs.",
      "version": "white"
    },
    {
      "text": "Extremely cautious, it quickly bounds off when it senses danger.",
      "version": "black-2"
    },
    {
      "text": "Extremely cautious, it quickly bounds off when it senses danger.",
      "version": "white-2"
    },
    {
      "text": "Extremely cautious, it quickly bounds off when it senses danger.",
      "version": "x"
    },
    {
      "text": "The ears appear to be delicate. If they are touched roughly, it kicks with its graceful legs.",
      "version": "y"
    },
    {
      "text": "Extremely cautious, it quickly bounds off when it senses danger.",
      "version": "omega-ruby"
    },
    {
      "text": "The ears appear to be delicate. If they are touched roughly, it kicks with its graceful legs.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Lopunny regrows its coat twice a year. Mufflers and hats made from its fur are really warm.",
      "version": "ultra-sun"
    },
    {
      "text": "It’s notably wary and has a dislike of fighting, but at the same time, it can deliver powerful kicks with its lithe legs.",
      "version": "ultra-moon"
    },
    {
      "text": "Lopunny is constantly monitoring its surroundings. If danger approaches, this Pokémon responds with superdestructive kicks.",
      "version": "sword"
    },
    {
      "text": "Once hot seasons are over, Lopunny’s coat will be replaced with fur that holds a lot of insulating air in preparation for colder weather.",
      "version": "shield"
    },
    {
      "text": "Its fur is warm and yet remarkably light. This Pokémon kicks as though it were a master of karate, driving back its opponents with ease.",
      "version": "legends-arceus"
    }
  ],
