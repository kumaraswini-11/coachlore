  "entries": [
    {
      "text": "It flies around forests and fields in search of bug Pokémon. It stays within a huge flock.",
      "version": "diamond"
    },
    {
      "text": "It lives in forests and fields. Squabbles over territory occur when flocks collide.",
      "version": "pearl"
    },
    {
      "text": "Recognizing their own weakness, they always live in a group. When alone, a STARAVIA cries noisily.",
      "version": "platinum"
    },
    {
      "text": "They maintain huge flocks, although fierce scuffles break out between various flocks.",
      "version": "heartgold"
