  "category": "Bagworm Pokémon",
  "entries": [
    {
      "text": "To shelter itself from cold, wintry winds, it covers itself with a cloak made of twigs and leaves.",
      "version": "diamond"
    },
    {
      "text": "If its cloak is broken in battle, it quickly remakes the cloak with materials nearby.",
      "version": "pearl"
    },
    {
      "text": "Even if it is born where there are no cocooning materials, it somehow always ends up with a cloak.",
      "version": "platinum"
    },
    {
      "text": "It covers itself with a cloak to shelter from the cold. When it’s hot, its cloak is thinner.",
      "version": "heartgold"
