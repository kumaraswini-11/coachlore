  "entries": [
    {
      "text": "This Ultra Beast came from the Ultra Wormhole. It seems not to attack enemies on its own, but its sharp body is a dangerous weapon in itself.",
      "version": "sun"
    },
    {
      "text": "One of the Ultra Beast life-forms, it was observed cutting down a gigantic steel tower with one stroke of its blade.",
      "version": "moon"
    },
    {
      "text": "This Ultra Beast’s body, which is as thin as paper, is like a sharpened sword.",
      "version": "ultra-sun"
    },
    {
      "text": "Although it’s alien to this world and a danger here, it’s apparently a common organism in the world where it normally lives.",
      "version": "ultra-moon"
    }
