{
  "category": "Attaching Pokémon",
  "entries": [
    {
      "text": "Joltik that live in cities have learned a technique for sucking electricity from the outlets in houses.",
      "version": "black"
    },
    {
      "text": "They attach themselves to large-bodied Pokémon and absorb static electricity, which they store in an electric pouch.",
      "version": "white"
    },
    {
      "text": "Since it can’t generate its own electricity, it sticks onto large-bodied Pokémon and absorbs static electricity.",
      "version": "black-2"
    },
    {
      "text": "Since it can’t generate its own electricity, it sticks onto large-bodied Pokémon and absorbs static electricity.",
