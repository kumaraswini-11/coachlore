{
  "category": "Cave Pokémon",
  "entries": [
    {
      "text": "It warms its body by absorbing sunlight with its wings. When its body temperature falls, it can no longer move.",
      "version": "black"
    },
    {
      "text": "It races through narrow caves, using its sharp claws to catch prey. The skin on its face is harder than a rock.",
      "version": "white"
    },
    {
      "text": "It runs through the narrow tunnels formed by Excadrill and Onix. It uses its sharp claws to catch prey.",
      "version": "black-2"
    },
    {
      "text": "It runs through the narrow tunnels formed by Excadrill and Onix. It uses its sharp claws to catch prey.",
      "version": "white-2"
    },
    {
      "text": "It races through narrow caves, using its sharp claws to catch prey. The skin on its face is harder than a rock.",
      "version": "x"
    },
    {
      "text": "It warms its body by absorbing sunlight with its wings. When its body temperature falls, it can no longer move.",
      "version": "y"
    },
    {
      "text": "It races through narrow caves, using its sharp claws to catch prey. The skin on its face is harder than a rock.",
      "version": "omega-ruby"
    },
    {
      "text": "It warms its body by absorbing sunlight with its wings. When its body temperature falls, it can no longer move.",
      "version": "alpha-sapphire"
    },
    {
      "text": "The red skin on its face is harder than rock. In narrow caves, it squares off against its enemies and charges face-first right into them.",
      "version": "ultra-sun"
    },
    {
      "text": "It infiltrates tunnels that Pokémon like Diglett and Dugtrio have dug and quietly waits for prey to pass through.",
      "version": "ultra-moon"
    },
    {
      "text": "Druddigon lives in caves, but it never skips sunbathing—it won’t be able to move if its body gets too cold.",
      "version": "sword"
    },
    {
      "text": "Druddigon are vicious and cunning. They take up residence in nests dug out by other Pokémon, treating the stolen nests as their own lairs.",
      "version": "shield"
    }
  ],
