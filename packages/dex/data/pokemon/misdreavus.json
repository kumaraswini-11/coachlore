{
  "category": "Screech Pokémon",
  "entries": [
    {
      "text": "It likes playing mischievous tricks such as screaming and wailing to startle people at night.",
      "version": "gold"
    },
    {
      "text": "It loves to bite and yank people's hair from behind without warning, just to see their shocked reactions.",
      "version": "silver"
    },
    {
      "text": "It loves to watch people it's scared. It frightens them by screaming loudly or appearing suddenly.",
      "version": "crystal"
    },
    {
      "text": "MISDREAVUS frightens people with a creepy, sobbing cry. The POKéMON apparently uses its red spheres to absorb the fearful feelings of foes and turn them into nutrition.",
      "version": "ruby"
    },
    {
      "text": "MISDREAVUS frightens people with a creepy, sobbing cry. The POKéMON apparently uses its red spheres to absorb the fearful feelings of foes and turn them into nutrition.",
      "version": "sapphire"
    },
    {
      "text": "A MISDREAVUS frightens people with a creepy, sobbing cry. It apparently uses its red spheres to absorb the fear of foes as its nutrition.",
      "version": "emerald"
    },
    {
      "text": "It loves to bite and yank people’s hair from behind without warning, just to see their shocked reactions.",
      "version": "firered"
    },
    {
      "text": "It likes playing mischievous tricks such as screaming and wailing to startle people at night.",
      "version": "leafgreen"
    },
    {
      "text": "It loves to sneak up on people late at night, then startle them with its shrieklike cry.",
      "version": "diamond"
    },
    {
      "text": "It gets nourishment from fear that it absorbs into its red orbs. In daytime, it sleeps in darkness.",
      "version": "pearl"
    },
    {
      "text": "A Pokémon that startles people in the middle of the night. It gathers fear as its energy.",
      "version": "platinum"
    },
    {
      "text": "It likes playing mischievous tricks, such as screaming and wailing to startle people at night.",
