{
  "category": "Clamping Pokémon",
  "entries": [
    {
      "text": "These mysterious Pokémon evolve when they receive electrical stimulation while they are in the same place as Shelmet.",
      "version": "black"
    },
    {
      "text": "When they feel threatened, they spit an acidic liquid to drive attackers away. This Pokémon targets Shelmet.",
      "version": "white"
    },
    {
      "text": "For some reason they evolve when they receive electrical energy while they are attacking Shelmet.",
      "version": "black-2"
    },
    {
      "text": "For some reason they evolve when they receive electrical energy while they are attacking Shelmet.",
      "version": "white-2"
    },
    {
      "text": "These mysterious Pokémon evolve when they receive electrical stimulation while they are in the same place as Shelmet.",
      "version": "x"
    },
    {
      "text": "For some reason they evolve when they receive electrical energy while they are attacking Shelmet.",
      "version": "y"
    },
    {
      "text": "These mysterious Pokémon evolve when they receive electrical stimulation while they are in the same place as Shelmet.",
      "version": "omega-ruby"
    },
    {
      "text": "For some reason they evolve when they receive electrical energy while they are attacking Shelmet.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Its strange physiology reacts to electrical energy in interesting ways. The presence of a Shelmet will cause this Pokémon to evolve.",
      "version": "sword"
    },
    {
      "text": "It spits a liquid from its mouth to melt through Shelmet’s shell. Karrablast doesn’t eat the shell— it eats only the contents.",
      "version": "shield"
    }
  ],
