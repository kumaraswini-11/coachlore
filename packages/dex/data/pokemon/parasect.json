{
  "category": "Mushroom Pokémon",
  "entries": [
    {
      "text": "A host-parasite pair in which the parasite mushroom has taken over the host bug. Prefers damp places.",
      "version": "red"
    },
    {
      "text": "A host-parasite pair in which the parasite mushroom has taken over the host bug. Prefers damp places.",
      "version": "blue"
    },
    {
      "text": "The bug host is drained of energy by the mushrooms on its back. They appear to do all the thinking.",
      "version": "yellow"
    },
    {
      "text": "It stays mostly in dark, damp places, the preference not of the bug, but of the big mushrooms on its back.",
      "version": "gold"
    },
    {
      "text": "The larger the mushroom on its back grows, the stronger the mushroom spores it scatters.",
      "version": "silver"
    },
    {
      "text": "When nothing's left to extract from the bug, the mushrooms on its back leave spores on the bug's egg.",
      "version": "crystal"
    },
    {
      "text": "PARASECT is known to infest large trees en masse and drain nutrients from the lower trunk and roots. When an infested tree dies, they move onto another tree all at once.",
      "version": "ruby"
    },
    {
      "text": "PARASECT is known to infest large trees en masse and drain nutrients from the lower trunk and roots. When an infested tree dies, they move onto another tree all at once.",
      "version": "sapphire"
    },
    {
      "text": "PARASECT are known to infest the roots of large trees en masse and drain nutrients. When an infested tree dies, they move onto another tree all at once.",
      "version": "emerald"
    },
    {
      "text": "It scatters toxic spores from the mushroom cap. In China, the spores are used as herbal medicine.",
      "version": "firered"
    },
    {
      "text": "A host-parasite pair in which the parasite mushroom has taken over the host bug. Prefers damp places.",
      "version": "leafgreen"
    },
    {
      "text": "A mushroom grown larger than the host’s body controls PARASECT. It scatters poisonous spores.",
      "version": "diamond"
    },
    {
      "text": "It is controlled by a mushroom grown larger than the bug body. It is said to prefer damp places.",
      "version": "pearl"
    },
    {
      "text": "A mushroom grown larger than the host’s body controls PARASECT. It scatters poisonous spores.",
      "version": "platinum"
    },
    {
      "text": "It stays mostly in dark, damp places, the preference not of the bug, but of the big mushroom on its back.",
      "version": "heartgold"
