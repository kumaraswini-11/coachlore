{
  "category": "Plump Mouse Pokémon",
  "entries": [
    {
      "text": "With nerves of steel, nothing can perturb it. It is more agile and active than it appears.",
      "version": "diamond"
    },
    {
      "text": "It constantly gnaws on logs and rocks to whittle down its front teeth. It nests alongside water.",
      "version": "pearl"
    },
    {
      "text": "A comparison revealed that BIDOOF’s front teeth grow at the same rate as RATTATA’s.",
      "version": "platinum"
    },
    {
      "text": "It lives in groups by the water. It chews up boulders and trees around its nest with its incisors.",
      "version": "heartgold"
    },
