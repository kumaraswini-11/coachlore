  "entries": [
    {
      "text": "Stiffens its ears to sense danger. The larger its horns, the more powerful its secreted venom.",
      "version": "red"
    },
    {
      "text": "Stiffens its ears to sense danger. The larger its horns, the more powerful its secreted venom.",
      "version": "blue"
    },
    {
      "text": "Its large ears are always kept upright. If it senses danger, it will attack with a poisonous sting.",
      "version": "yellow"
    },
    {
      "text": "It is small, but its horn is filled with poison. It charges then stabs with the horn to inject poison.",
      "version": "gold"
    },
    {
      "text": "It raises its big ears to check its surroundings. It will strike first if it senses any danger.",
      "version": "silver"
    },
    {
      "text": "It constantly moves its large ears in many directions in order to detect danger right away.",
      "version": "crystal"
    },
    {
      "text": "The male NIDORAN has developed muscles for moving its ears. Thanks to them, the ears can be freely moved in any direction. Even the slightest sound does not escape this POKéMON’s notice.",
      "version": "ruby"
    },
    {
      "text": "The male NIDORAN has developed muscles for moving its ears. Thanks to them, the ears can be freely moved in any direction. Even the slightest sound does not escape this POKéMON’s notice.",
