{
  "category": "Water Fish Pokémon",
  "entries": [
    {
      "text": "This carefree POKéMON has an easy-going nature. While swimming, it always bumps into boat hulls.",
      "version": "gold"
    },
    {
      "text": "Due to its relaxed and carefree attitude, it often bumps its head on boulders and boat hulls as it swims.",
      "version": "silver"
    },
    {
      "text": "Its body is always slimy. It often bangs its head on the river bottom as it swims but seems not to care.",
      "version": "crystal"
    },
    {
      "text": "QUAGSIRE hunts for food by leaving its mouth wide open in water and waiting for its prey to blunder in unaware. Because the POKéMON does not move, it does not get very hungry.",
      "version": "ruby"
    },
    {
      "text": "QUAGSIRE hunts for food by leaving its mouth wide open in water and waiting for its prey to blunder in unaware. Because the POKéMON does not move, it does not get very hungry.",
