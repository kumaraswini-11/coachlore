    {
      "text": "Smeargle marks the boundaries of its territory using a body fluid that leaks out from the tip of its tail. Over 5,000 different marks left by this Pokémon have been found.",
      "version": "omega-ruby"
    },
    {
      "text": "Smeargle marks the boundaries of its territory using a body fluid that leaks out from the tip of its tail. Over 5,000 different marks left by this Pokémon have been found.",
      "version": "alpha-sapphire"
    },
    {
      "text": "The unique creations produced by each Smeargle are painted using the fluid that oozes from its tail. This is how it marks its territory.",
      "version": "sun"
    },
    {
      "text": "It draws symbols all over the place to mark its territory. In towns with many Smeargle, the walls are covered in graffiti.",
      "version": "moon"
    },
    {
      "text": "The fluid of Smeargle’s tail secretions changes in the intensity of its hue as the Pokémon’s emotions change.",
      "version": "ultra-sun"
    },
    {
      "text": "It draws symbols with the fluid that oozes from the tip of its tail. Depending on the symbol, Smeargle fanatics will pay big money for them.",
      "version": "ultra-moon"
    }
