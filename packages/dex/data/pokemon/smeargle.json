  "category": "Painter Pokémon",
  "entries": [
    {
      "text": "A special fluid oozes from the tip of its tail. It paints the fluid everywhere to mark its territory.",
      "version": "gold"
    },
    {
      "text": "Once it becomes an adult, it has a tendency to let its comrades plant footprints on its back.",
      "version": "silver"
    },
    {
      "text": "The color of the mysterious fluid secreted from its tail is predetermined for each SMEARGLE.",
      "version": "crystal"
    },
    {
      "text": "SMEARGLE marks the boundaries of its territory using a body fluid that leaks out from the tip of its tail. Over 5,000 different marks left by this POKéMON have been found.",
      "version": "ruby"
    },
    {
      "text": "SMEARGLE marks the boundaries of its territory using a body fluid that leaks out from the tip of its tail. Over 5,000 different marks left by this POKéMON have been found.",
