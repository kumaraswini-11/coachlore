{
  "category": "Humming Pokémon",
  "entries": [
    {
      "text": "ALTARIA dances and wheels through the sky among billowing, cotton-like clouds. By singing melodies in its crystal-clear voice, this POKéMON makes its listeners experience dreamy wonderment.",
      "version": "ruby"
    },
    {
      "text": "ALTARIA sings in a gorgeous soprano. Its wings are like cotton clouds. This POKéMON catches updrafts with its buoyant wings and soars way up into the wild blue yonder.",
      "version": "sapphire"
    },
    {
      "text": "It hums in a beautiful soprano voice. It flies among white clouds in the blue sky. It launches intensely hot fireballs from its mouth.",
      "version": "emerald"
    },
    {
      "text": "If you hear a beautiful melody trilling deep among mountains far from people, it is ALTARIA’s humming.",
      "version": "firered"
    },
    {
      "text": "If you hear a beautiful melody trilling deep among mountains far from people, it is ALTARIA’s humming.",
      "version": "leafgreen"
    },
    {
      "text": "It looks like a fluffy cloud when it is in flight. It hums with its soprano voice.",
      "version": "diamond"
    },
    {
      "text": "It looks like a fluffy cloud when it is in flight. It hums with its soprano voice.",
      "version": "pearl"
    },
    {
      "text": "If it bonds with a person, it will gently envelop the friend with its soft wings, then hum.",
      "version": "platinum"
    },
    {
      "text": "It flies gracefully through the sky. Its melodic humming makes you feel like you’re in a dream.",
      "version": "heartgold"
    },
    {
      "text": "It flies gracefully through the sky. Its melodic humming makes you feel like you’re in a dream.",
      "version": "soulsilver"
    },
    {
      "text": "If it bonds with a person, it will gently envelop the friend with its soft wings, then hum.",
      "version": "black"
    },
    {
      "text": "If it bonds with a person, it will gently envelop the friend with its soft wings, then hum.",
      "version": "white"
    },
    {
      "text": "On sunny days, it flies freely through the sky and blends into the clouds. It sings in a beautiful soprano.",
      "version": "black-2"
    },
    {
      "text": "On sunny days, it flies freely through the sky and blends into the clouds. It sings in a beautiful soprano.",
      "version": "white-2"
