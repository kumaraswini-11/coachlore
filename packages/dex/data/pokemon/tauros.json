{
  "category": "Wild Bull Pokémon",
  "entries": [
    {
      "text": "When it targets an enemy, it charges furiously while whipping its body with its long tails.",
      "version": "red"
    },
    {
      "text": "When it targets an enemy, it charges furiously while whipping its body with its long tails.",
      "version": "blue"
    },
    {
      "text": "A rowdy POKéMON with a lot of stamina. Once running, it won't stop until it hits something.",
      "version": "yellow"
    },
    {
      "text": "They fight each other by locking horns. The herd's protector takes pride in its battle-scarred horns.",
      "version": "gold"
    },
    {
      "text": "After heightening its will to fight by whipping itself with its three tails, it charges at full speed.",
      "version": "silver"
    },
    {
      "text": "These violent POKéMON fight with other mem bers of their herd in order to prove their strength.",
      "version": "crystal"
    },
    {
      "text": "This POKéMON is not satisfied unless it is rampaging at all times. If there is no opponent for TAUROS to battle, it will charge at thick trees and knock them down to calm itself.",
      "version": "ruby"
    },
    {
      "text": "This POKéMON is not satisfied unless it is rampaging at all times. If there is no opponent for TAUROS to battle, it will charge at thick trees and knock them down to calm itself.",
      "version": "sapphire"
    },
    {
      "text": "It is not satisfied unless it is rampaging at all times. If there is no opponent for TAUROS to battle, it will charge at thick trees and knock them down to calm itself.",
      "version": "emerald"
    },
    {
      "text": "When it is about to TACKLE, it whips its body repeatedly with its three long tails.",
      "version": "firered"
    },
    {
      "text": "When it targets an enemy, it charges furiously while whipping its body with its long tails.",
      "version": "leafgreen"
    },
    {
      "text": "Once it takes aim at its foe, it makes a headlong charge. It is famous for its violent nature.",
      "version": "diamond"
    },
    {
      "text": "Once it takes aim at its foe, it makes a headlong charge. It is famous for its violent nature.",
      "version": "pearl"
    },
    {
      "text": "Once it takes aim at its foe, it makes a headlong charge. It is famous for its violent nature.",
      "version": "platinum"
    },
