{
  "category": "Subterrene Pokémon",
  "entries": [
    {
      "text": "It can help in tunnel construction. Its drill has evolved into steel strong enough to bore through iron plates.",
      "version": "black"
    },
    {
      "text": "More than 300 feet below the surface, they build mazelike nests. Their activity can be destructive to subway tunnels.",
      "version": "white"
    },
    {
      "text": "Forming a drill with its steel claws and head, it can bore through a steel plate, no matter how thick it is.",
      "version": "black-2"
    },
