{
  "category": "Clay Doll Pokémon",
  "entries": [
    {
      "text": "BALTOY moves while spinning around on its one foot. Primitive wall paintings depicting this POKéMON living among people were discovered in some ancient ruins.",
      "version": "ruby"
    },
    {
      "text": "As soon as it spots others of its kind, BALTOY congregates with them and then begins crying noisily in unison. This POKéMON sleeps while cleverly balancing itself on its one foot.",
      "version": "sapphire"
    },
    {
      "text": "A BALTOY moves by spinning on its single foot. It has been depicted in murals adorning the walls of a once-bustling city in an ancient age.",
      "version": "emerald"
    },
    {
      "text": "It was discovered in ancient ruins. While moving, it constantly spins. It stands on one foot even when asleep.",
      "version": "firered"
    },
    {
      "text": "It was discovered in ancient ruins. While moving, it constantly spins. It stands on one foot even when asleep.",
