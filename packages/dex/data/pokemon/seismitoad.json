      "version": "x"
    },
    {
      "text": "They shoot paralyzing liquid from their head bumps. They use vibration to hurt their opponents.",
      "version": "y"
    },
    {
      "text": "It increases the power of its punches by vibrating the bumps on its fists. It can turn a boulder to rubble with one punch.",
      "version": "omega-ruby"
    },
    {
      "text": "They shoot paralyzing liquid from their head bumps. They use vibration to hurt their opponents.",
      "version": "alpha-sapphire"
    },
    {
      "text": "The vibrating of the bumps all over its body causes earthquake-like tremors. Seismitoad and Croagunk are similar species.",
      "version": "sword"
    },
    {
      "text": "This Pokémon is popular among the elderly, who say the vibrations of its lumps are great for massages.",
      "version": "shield"
    }
