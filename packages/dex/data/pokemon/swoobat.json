{
  "category": "Courting Pokémon",
  "entries": [
    {
      "text": "It emits sound waves of various frequencies from its nose, including some powerful enough to destroy rocks.",
      "version": "black"
    },
    {
      "text": "Anyone who comes into contact with the ultrasonic waves emitted by a courting male experiences a positive mood shift.",
      "version": "white"
    },
    {
      "text": "It shakes its tail vigorously when it emits ultrasonic waves strong enough to reduce concrete to rubble.",
      "version": "black-2"
    },
    {
      "text": "It shakes its tail vigorously when it emits ultrasonic waves strong enough to reduce concrete to rubble.",
      "version": "white-2"
    },
    {
      "text": "It shakes its tail vigorously when it emits ultrasonic waves strong enough to reduce concrete to rubble.",
      "version": "x"
    },
    {
      "text": "Anyone who comes into contact with the ultrasonic waves emitted by a courting male experiences a positive mood shift.",
      "version": "y"
    },
    {
      "text": "It shakes its tail vigorously when it emits ultrasonic waves strong enough to reduce concrete to rubble.",
      "version": "omega-ruby"
    },
    {
      "text": "Anyone who comes into contact with the ultrasonic waves emitted by a courting male experiences a positive mood shift.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Emitting powerful sound waves tires it out. Afterward, it won’t be able to fly for a little while.",
      "version": "sword"
    },
    {
      "text": "The auspicious shape of this Pokémon’s nose apparently led some regions to consider Swoobat a symbol of good luck.",
      "version": "shield"
    }
  ],
