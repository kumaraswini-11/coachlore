{
  "category": "Turn Tail Pokémon",
  "entries": [
    {
      "text": "This Pokémon is a coward. As it desperately dashes off, the flailing of its many legs leaves a sparkling clean path in its wake.",
      "version": "sun"
    },
    {
      "text": "Its habitat varies from beaches to seabeds. A natural scavenger, it will gleefully chow down on anything edible, no matter how rotten.",
      "version": "moon"
    },
    {
      "text": "It will pick up anything it finds on the ground. Sometimes it finds coins, so Murkrow and Meowth will go after it.",
      "version": "ultra-sun"
    },
    {
      "text": "An astonishingly cowardly Pokémon, Wimpod will whir its legs at high speeds to run away if anything comes near it.",
      "version": "ultra-moon"
    },
    {
      "text": "It’s nature’s cleaner—it eats anything and everything, including garbage and rotten things. The ground near its nest is always clean.",
      "version": "sword"
    },
    {
      "text": "Wimpod gather in swarms, constantly on the lookout for danger. They scatter the moment they detect an enemy’s presence.",
      "version": "shield"
    }
  ],
