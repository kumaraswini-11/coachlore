{
  "category": "Lamp Pokémon",
  "entries": [
    {
      "text": "This ominous Pokémon is feared. Through cities it wanders, searching for the spirits of the fallen.",
      "version": "black"
    },
    {
      "text": "It arrives near the moment of death and steals spirit from the body.",
      "version": "white"
    },
    {
      "text": "The spirits it absorbs fuel its baleful fire. It hangs around hospitals waiting for people to pass on.",
      "version": "black-2"
    },
    {
      "text": "The spirits it absorbs fuel its baleful fire. It hangs around hospitals waiting for people to pass on.",
      "version": "white-2"
    },
    {
      "text": "The spirits it absorbs fuel its baleful fire. It hangs around hospitals waiting for people to pass on.",
      "version": "x"
    },
    {
      "text": "It arrives near the moment of death and steals spirit from the body.",
      "version": "y"
    },
    {
      "text": "The spirits it absorbs fuel its baleful fire. It hangs around hospitals waiting for people to pass on.",
      "version": "omega-ruby"
    },
    {
      "text": "It arrives near the moment of death and steals spirit from the body.",
      "version": "alpha-sapphire"
    },
    {
      "text": "This Pokémon appears just before someone passes away, so it’s feared as an emissary of death.",
      "version": "sword"
    },
    {
      "text": "It lurks in cities, pretending to be a lamp. Once it finds someone whose death is near, it will trail quietly after them.",
      "version": "shield"
    }
