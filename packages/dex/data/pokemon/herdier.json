{
  "category": "Loyal Dog Pokémon",
  "entries": [
    {
      "text": "It has black, cape-like fur that is very hard and decreases the amount of damage it receives.",
      "version": "black"
    },
    {
      "text": "It loyally follows its Trainer’s orders. For ages, they have helped Trainers raise Pokémon.",
      "version": "white"
    },
    {
      "text": "This very loyal Pokémon helps Trainers, and it also takes care of other Pokémon.",
      "version": "black-2"
    },
    {
      "text": "This very loyal Pokémon helps Trainers, and it also takes care of other Pokémon.",
      "version": "white-2"
    },
    {
      "text": "This very loyal Pokémon helps Trainers, and it also takes care of other Pokémon.",
      "version": "x"
    },
    {
      "text": "It has black, cape-like fur that is very hard and decreases the amount of damage it receives.",
      "version": "y"
    },
    {
      "text": "This very loyal Pokémon helps Trainers, and it also takes care of other Pokémon.",
      "version": "omega-ruby"
    },
    {
      "text": "It has black, cape-like fur that is very hard and decreases the amount of damage it receives.",
      "version": "alpha-sapphire"
    },
    {
      "text": "Its dense black fur grows continuously. The high cost of keeping its hard fur properly groomed makes this a troublesome Pokémon to train.",
      "version": "sun"
    },
    {
      "text": "This Pokémon obeys its master’s orders faithfully. However, it refuses to listen to anything said by a person it doesn’t respect.",
      "version": "moon"
    },
    {
      "text": "The longer its black fur grows, the harder and more impervious it gets. Claws and fangs can’t easily penetrate it.",
      "version": "ultra-sun"
    },
    {
      "text": "It has been living with people for so long that portrayals of it can be found on the walls of caves from long, long ago.",
      "version": "ultra-moon"
    },
    {
      "text": "Herdier is a very smart and friendly Pokémon. So much so that there’s a theory that Herdier was the first Pokémon to partner with people.",
      "version": "sword"
    },
    {
      "text": "The black fur that covers this Pokémon’s body is dense and springy. Even sharp fangs bounce right off.",
      "version": "shield"
    }
  ],
