    {
      "text": "The oil-filled end of its tail floats on water. It keeps Marill from drowning even in a strong current.",
      "version": "white"
    },
    {
      "text": "The oil-filled tail functions as a buoy, so it’s fine even in rivers with strong currents.",
      "version": "black-2"
    },
    {
      "text": "The oil-filled tail functions as a buoy, so it’s fine even in rivers with strong currents.",
      "version": "white-2"
