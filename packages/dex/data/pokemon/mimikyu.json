{
  "category": "Disguise Pokémon",
  "entries": [
    {
      "text": "Its actual appearance is unknown. A scholar who saw what was under its rag was overwhelmed by terror and died from the shock.",
      "version": "sun"
    },
    {
      "text": "A lonely Pokémon, it conceals its terrifying appearance beneath an old rag so it can get closer to people and other Pokémon.",
      "version": "moon"
    },
    {
      "text": "Although it’s a quiet, lonely Pokémon, if you try to look at what’s under its rag, it will become agitated and resist violently.",
      "version": "ultra-sun"
    },
    {
      "text": "A gust of wind revealed what hides under this Pokémon’s rag to a passing Trainer, who went home and died painfully that very night.",
      "version": "ultra-moon"
    },
    {
      "text": "It wears a rag fashioned into a Pikachu costume in an effort to look less scary. Unfortunately, the costume only makes it creepier.",
      "version": "sword"
    },
    {
      "text": "There was a scientist who peeked under Mimikyu’s old rag in the name of research. The scientist died of a mysterious disease.",
      "version": "shield"
    }
  ],
