{
  "category": "Bird Pokémon",
  "entries": [
    {
      "text": "Very protective of its sprawling territorial area, this POKéMON will fiercely peck at any intruder.",
      "version": "red"
    },
    {
      "text": "Very protective of its sprawling territorial area, this POKéMON will fiercely peck at any intruder.",
      "version": "blue"
    },
    {
      "text": "This POKéMON is full of vitality. It constantly flies around its large territory in search of prey.",
      "version": "yellow"
    },
    {
      "text": "It has outstanding vision. However high it flies, it is able to distinguish the movements of its prey.",
      "version": "gold"
    },
    {
      "text": "It immobilizes its prey using well- developed claws, then carries the prey more than 60 miles to its nest.",
      "version": "silver"
    },
    {
      "text": "It slowly flies in a circular pattern, all the while keeping a sharp lookout for prey.",
      "version": "crystal"
    },
    {
      "text": "PIDGEOTTO claims a large area as its own territory. This POKéMON flies around, patrolling its living space. If its territory is violated, it shows no mercy in thoroughly punishing the foe with its sharp claws.",
      "version": "ruby"
    },
    {
