# Coachlore web app. Copy to .env.local for local values; set the required
# ones in Vercel → Settings → Environment Variables. Secrets never go here.

# --- Site ----------------------------------------------------------------
# Optional: overrides the site's address (else Vercel's, or localhost).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reviewing on a phone ------------------------------------------------
# Optional, development only: this machine's address on the local network
# (or several, comma-separated), so a phone on the same Wi-Fi can open
# `bun run dev` at http://<address>:3000 (Next.js's allowedDevOrigins).
# DEV_ORIGINS=192.168.1.20

# --- Sentry (error reporting) --------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=<your-sentry-dsn>
SENTRY_ORG=<your-sentry-org-slug>
SENTRY_PROJECT=<your-sentry-project-slug>
# Secret: Sentry → Settings → Auth Tokens(Organization token).
SENTRY_AUTH_TOKEN=<your-sentry-auth-token>
