# Copy to .env.local for local values; .env files other than this one are
# gitignored. Next.js inlines NEXT_PUBLIC_ variables into the build, so they
# must be set when the app is built, not only when it runs.

# The site's public address, with no trailing slash. Canonical URLs, link
# previews (Open Graph), robots.txt and the sitemap are built from it.
# Unset, it defaults to http://localhost:3000, so a production build must set
# it to the production address, or shared links and canonical tags will point
# at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
