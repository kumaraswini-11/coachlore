{
  "name": "coachlore",
  "description": "A fast, mobile-first Pokédex and a home for Pokémon draft leagues, from the live draft to the final standings.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:logical-css",
    "lint:logical-css": "bun scripts/check-logical-css.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "data:refresh": "bun run --filter @workspace/dex update-pins && bun run --filter @workspace/dex import && bun run --filter web import-images",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  },
  "trustedDependencies": [],
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": "^24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/postcss": "4.3.3",
      "@types/node": "24.19.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "eslint": "10.12.0",
      "lucide-react": "1.52.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "typescript": "6.0.3",
      "vitest": "5.0.3",
      "zod": "4.6.5"
    }
  }
}
