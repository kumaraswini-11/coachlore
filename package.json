{
  "name": "draftboard",
  "description": "A fast, mobile-first Pokédex and a home for Pokémon draft leagues: live drafts, schedules, trades, standings and AI match recaps from real battle logs.",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": "^24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/postcss": "4.3.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "eslint": "10.12.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "typescript": "6.0.3"
    }
  }
}
